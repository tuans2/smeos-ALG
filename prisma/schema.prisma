  job_events                                       job_events[]
  video_scenes                                     video_scenes[]
  internal_chat_messages                           internal_chat_messages[]
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  integration_connections_by_inherited_from_org_id integration_connections[]       @relation("fk_integration_connections_inherited_from_org_id")
  reconciliation_findings                          reconciliation_findings[]
  organization_links_as_parent                     organization_links[]            @relation("OrgLinkParent")
  organization_links_as_child                      organization_links[]            @relation("OrgLinkChild")
  custom_domains                                   custom_domains[]

