// Nguồn sự thật lược đồ của floraos-core.
// Worker Python đọc lược đồ sinh sẵn, không tự khai bảng (V2 mục 3.1).
//
// Luật bắt buộc với mọi model thêm vào đây:
//   1. Mọi bản ghi thuộc tenant mang organization_id, có index. Không ngoại lệ.
//   2. Đặt tên snake_case tiếng Anh.
//   3. generation_jobs tách ba trục: status / stage / result.
//   4. Cột thời gian khai @db.Timestamptz(3). Bảng con của bảng tenant trỏ về cha bằng
//      khoá ghép (cha_id, organization_id) — hoàn thiện CSDL 05/11/2026.
//
// `users` là bảng duy nhất không có organization_id — một người thuộc nhiều
// tổ chức qua `memberships`.
//
// Chuỗi kết nối không nằm trong tệp này. Prisma 7 đọc nó từ `prisma.config.ts`
// cho lệnh migrate, và từ driver adapter cho `PrismaClient`.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ── Kiểu liệt kê ────────────────────────────────────────────────────────────
// Bộ giá trị của P1. Các enum còn lại (job_status, asset_kind, …) thêm ở pha
// sở hữu bảng tương ứng.

/// `FLOWER_NETWORK` đã gộp vào `CHAIN` (ADR-012 D-T11 / D-55, bước T-8b) — chỉ khác nhãn.
enum organization_type {
  EXPERIENCE
  SINGLE
  STORE
  CHAIN
}

enum workspace_kind {
  EXPERIENCE
  PRODUCTION
}

enum membership_status {
  INVITED
  ACTIVE
  SUSPENDED
}

enum trial_status {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

enum capability_scope {
  ORGANIZATION
  BRANCH
  STORE
  FLOWER_NETWORK
}

// Nền AI — đợt AI-1 (đặc tả 10). Sổ đăng ký năng lực và mô hình là dữ liệu
// cấp NỀN TẢNG, không mang organization_id; chính sách, sổ chi phí và điểm
// chấm thì thuộc tenant.

enum ai_mode {
  API
  SELF_HOST
  DETERMINISTIC
}

enum ai_privacy_level {
  PUBLIC
  SHOP
  SENSITIVE
}

enum ai_measure_state {
  CHUA_DO
  THU_NGHIEM
  SAN_XUAT
}

// ── Nền tảng đa tenant — P1 ─────────────────────────────────────────────────

/// Duyệt tài khoản tự đăng ký (PO 22/10/2026): tài khoản tự đăng ký hoặc dùng thử bắt đầu ở
/// PENDING và chưa đăng nhập được cho tới khi superadmin nền tảng (mã N13) duyệt.
enum user_approval_status {
  PENDING
  APPROVED
  REJECTED
}

model users {
  id                   String               @id @default(uuid())
  /// @pii contact
  email                String               @unique
  password_hash        String?
  /// @pii identity
  name                 String?
  avatar_url           String?
  /// @pii contact
  phone                String?
  locale               String               @default("vi")
  // Mặc định APPROVED: tài khoản có sẵn, nhân viên được mời, tài khoản tạo bằng script vận hành
  approval_status      user_approval_status @default(APPROVED)
  approval_decided_at  DateTime?            @db.Timestamptz(3)
  approval_decided_by  String? // user_id của superadmin
  /// Tài khoản đang dùng mật khẩu tạm (Điều hành tạo hoặc đặt lại) — phải tự đổi trước khi dùng hệ
  /// thống (PO 04/11/2026, checklist ALG 1.4). Tự đổi mật khẩu thì về false.
  must_change_password Boolean              @default(false)
  created_at           DateTime             @default(now()) @db.Timestamptz(3)
  updated_at           DateTime             @updatedAt @db.Timestamptz(3)

  memberships memberships[]
  sessions    sessions[]

  // Console Vận hành Nền tảng (P25) — độc lập với memberships, xem mục cuối tệp
  platform_operator platform_operators?

  // Internal Chat
  internal_chat_participations internal_chat_participants[]
  internal_chat_messages_sent  internal_chat_messages[]     @relation("ChatSender")

  @@index([approval_status, created_at])
}

model sessions {
  id              String    @id @default(uuid())
  user_id         String
  token_hash      String    @unique
  organization_id String? // tổ chức đang hoạt động của phiên
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  expires_at      DateTime  @db.Timestamptz(3)
  revoked_at      DateTime? @db.Timestamptz(3)

  updated_at   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  user         users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization organizations? @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([organization_id])
}

model organizations {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  type             organization_type @default(SINGLE)
  credit_balance   Int               @default(0)
  credit_plan      String?
  settings         Json? // bảng công tắc cấp tổ chức, gồm cho_phep_tu_duyet
  data_region      String?           @default("vn") // ADR-006: Vùng dữ liệu tenant
  // SDAGF D-04 — legal hold cấp tổ chức: còn hạn thì không xoá vĩnh viễn dữ
  // liệu nào của tổ chức (asset, sản phẩm trong thùng rác, dọn bàn giao).
  legal_hold_until DateTime?         @db.Timestamptz(3)
  /// ADR-012 D-T6 (T-6a): ngành của tổ chức → `industries.key`. Thay `settings.industry`; tới T-6c trigger
  /// `organizations_sync_industry_key` giữ cột này khớp `settings.industry` mỗi lần ghi settings.
  industry_key     String?
  created_at       DateTime          @default(now()) @db.Timestamptz(3)
  updated_at       DateTime          @updatedAt @db.Timestamptz(3)

  industry industries? @relation(fields: [industry_key], references: [key], onUpdate: Cascade, onDelete: Restrict)

  // Khoá ngoại tới organizations mở lại ở P3 (TECHNICAL_DEBT #8) — bốn bảng
  // dưới đây là bốn bảng nợ đó; assets/generation_jobs/usage/audit_logs khai
  // khoá ngoại ngay từ khi tạo, không nợ.
  workspaces                                       workspaces[]
  branches                                         branches[]
  capability_overrides                             capability_overrides[]
  memberships                                      memberships[]
  assets                                           assets[]
  storage_outbox                                   storage_outbox[]
  landing_pages                                    landing_pages[]
  shop_reviews                                     shop_reviews[]
  generation_jobs                                  generation_jobs[]
  idempotency_keys                                 idempotency_keys[]
  usage                                            usage[]
  audit_logs                                       audit_logs[]
  platform_access_logs                             platform_access_logs[]
  order_recipients                                 order_recipients[]
  shared_order_access                              shared_order_access[]
  tenant_data_keys                                 tenant_data_keys[]
  business_profile                                 business_profiles?
  brand_profile                                    brand_profiles?
  products                                         products[]
  product_variants                                 product_variants[]
  product_images                                   product_images[]
  product_analyses                                 product_analyses[]
  product_inventory                                product_inventory[]
  product_bookings                                 product_bookings[]
  pricing_rules                                    pricing_rules[]
  integration_tokens                               integration_tokens[]
  integration_connections                          integration_connections[]
  integration_events                               integration_events[]
  integration_sync_cursors                         integration_sync_cursors[]
  sales_channel_listings                           sales_channel_listings[]
  sales_channel_orders                             sales_channel_orders[]
  ai_policies                                      ai_policies[]
  ai_requests                                      ai_requests[]
  ai_evaluations                                   ai_evaluations[]
  occasions                                        occasions[]
  template_overrides                               template_overrides[]
  catalog_links                                    catalog_links[]
  store_share_links                                store_share_links[]
  brand_library_items                              brand_library_items[]
  product_copies                                   product_copies[]
  content_metrics                                  content_metrics[]
  video_jobs                                       video_jobs[]
  orders                                           orders[]
  order_items                                      order_items[]
  order_assignments                                order_assignments[]
  order_events                                     order_events[]
  customers                                        customers[]
  customer_occasions                               customer_occasions[]
  journey_runs                                     journey_runs[]
  customer_consents                                customer_consents[]
  vouchers                                         vouchers[]
  voucher_batches                                  voucher_batches[]
  voucher_redemptions                              voucher_redemptions[]
  chat_conversations                               chat_conversations[]
  chat_messages                                    chat_messages[]
  chat_channel_integrations                        chat_channel_integrations[]
  content_opportunities                            content_opportunities[]
  product_analysis_runs                            product_analysis_runs[]
  campaign_packages                                campaign_packages[]
  content_drafts                                   content_drafts[]
  content_generations                              content_generations[]
  voice_clones                                     voice_clones[]
  music_tracks                                     music_tracks[]
  partners                                         partners[]
  order_coordinations                              order_coordinations[]
  order_qc_records                                 order_qc_records[]
  order_payments                                   order_payments[]
  order_exceptions                                 order_exceptions[]
  field_config_overrides                           field_config_overrides[]
  credit_transactions                              credit_transactions[]
  usage_limits                                     usage_limits[]
  provider_cost_entries                            provider_cost_entries[]
  subscription                                     subscriptions?
  subscription_invoices                            subscription_invoices[]
  owned_field_definitions                          field_definitions[]             @relation("field_definition_owner")
  order_info_requests                              order_info_requests[]
  order_change_requests                            order_change_requests[]
  product_change_requests                          product_change_requests[]
  product_revisions                                product_revisions[]
  product_import_batches                           product_import_batches[]
  greeting_catalogs                                greeting_catalogs[]
  greeting_catalog_products                        greeting_catalog_products[]
  greeting_sessions                                greeting_sessions[]
  greeting_journey_events                          greeting_journey_events[]
  greeting_integration                             greeting_integrations?
  greeting_payment_events                          greeting_payment_events[]
  greeting_notifications                           greeting_notifications[]
  greeting_catalog_events                          greeting_catalog_events[]
  greeting_messages                                greeting_messages[]
  greeting_share_links                             greeting_share_links[]
  greeting_message_reads                           greeting_message_reads[]
  staff_notifications                              staff_notifications[]
  internal_chat_conversations                      internal_chat_conversations[]
  internal_chat_participations                     internal_chat_participants[]
  notification_org_policies                        notification_org_policies[]
  notification_store_defaults                      notification_store_defaults[]
  notification_user_preferences                    notification_user_preferences[]
  notification_inbox                               notification_inbox[]
  materials                                        materials[]
  material_price_history                           material_price_history[]
  product_recipes                                  product_recipes[]
  product_recipe_items                             product_recipe_items[]
