/// Ngành — bảng NỀN TẢNG (không có organization_id), ADR-012 D-T6. `key` = khoá plugin ngành
/// (`src/modules/organization/domain/industries`). Tầng Ngành chưa bật: chưa có tổ chức loại INDUSTRY,
/// chưa có vai quản trị ngành. Thêm ngành = thêm plugin + một dòng ở đây.
model industries {
  key        String          @id
  name       String
  status     industry_status @default(ACTIVE)
  created_at DateTime        @default(now()) @db.Timestamptz(3)
  updated_at DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  organizations organizations[]
}

enum industry_status {
  ACTIVE
  INACTIVE
}

model workspaces {
  id              String         @id @default(uuid())
  organization_id String
  name            String
  kind            workspace_kind @default(PRODUCTION)
  trial_count     Int            @default(0)
  trial_limit     Int?
  trial_reset_at  DateTime?      @db.Timestamptz(3)
  trial_status    trial_status?
  created_at      DateTime       @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  generation_jobs_by_workspace_id generation_jobs[] @relation("fk_generation_jobs_workspace_id")
  usage_by_workspace_id           usage[]           @relation("fk_usage_workspace_id")
  journey_runs_by_workspace_id    journey_runs[]    @relation("fk_journey_runs_workspace_id")

  @@index([organization_id])
}

/// Chi nhánh của một tổ chức — ranh giới phạm vi quyền (`memberships.branch_id`), không phải ranh giới tenant.
/// ADR-012 D-T2 (T-4): `chain_branches` đã gộp vào đây (xoá ở T-4c); `accepts_dispatch` = chi nhánh nằm trong danh sách nhận
/// đơn điều phối chuỗi (nhập Excel), `code` là mã trên link gia công (`?branch=`). Các cột vận hành điều phối
/// chỉ có nghĩa khi `accepts_dispatch = true`.
model branches {
  id                   String   @id @default(uuid())
  organization_id      String
  name                 String
  code                 String
  /// @pii business
  address              String?
  is_active            Boolean  @default(true)
  accepts_dispatch     Boolean  @default(false)
  /// Khu vực hành chính — sàng lọc theo phường/quận/tỉnh khi không có toạ độ
  ward                 String?
  district             String?
  province             String?
  /// Phường/xã lân cận chi nhánh nhận giao thêm (mảng chuỗi)
  service_wards        Json?
  latitude             Float?
  longitude            Float?
  quality_score        Float    @default(90)
  active_jobs_count    Int      @default(0)
  max_concurrent_jobs  Int      @default(5)
  channels             Json? // { phone, telegramChatId, zaloPhone, zaloUserId, messengerId }
  /// Mã chi nhánh nhắn vào Zalo OA chung để liên kết (duy nhất toàn nền tảng)
  zalo_link_code       String?  @unique
  cancellation_count   Int      @default(0)
  bypass_count         Int      @default(0)
  cancellation_history Json? // tối đa 50 mục gần nhất
  bypass_history       Json?
  created_at           DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations       @relation(fields: [organization_id], references: [id])
  inventory    product_inventory[]

  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  memberships_by_branch_id     memberships[]     @relation("fk_memberships_branch_id")
  generation_jobs_by_branch_id generation_jobs[] @relation("fk_generation_jobs_branch_id")
  products_by_branch_id        products[]        @relation("fk_products_branch_id")
  pricing_rules_by_branch_id   pricing_rules[]   @relation("fk_pricing_rules_branch_id")
  orders_by_branch_id          orders[]          @relation("fk_orders_branch_id")
  customers_by_branch_id       customers[]       @relation("fk_customers_branch_id")

  @@unique([organization_id, code])
  @@index([organization_id])
}

model roles {
  id              String   @id @default(uuid())
  organization_id String? // null = vai hệ thống, dùng chung mọi tổ chức
  key             String // dieu_hanh · sale · dieu_phoi · experience_user
  name            String
  is_system       Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations?      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  capabilities role_capabilities[]

  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  memberships_by_role_id          memberships[]          @relation("fk_memberships_role_id")
  capability_overrides_by_role_id capability_overrides[] @relation("fk_capability_overrides_role_id")

  @@unique([organization_id, key])
  @@index([organization_id])
}

/**
 * Bảng công tắc: mã năng lực nào đang bật cho một vai (đặc tả 02 mục 1, lớp
 * hai). Vai hệ thống (`organization_id = null` của chính `roles`) được nạp
 * sẵn từ bản mặc định trong `src/core/rbac/capability-catalog.ts` lúc
 * `ensureSystemRoles`. Vai riêng của tổ chức có switchboard của chính nó.
 * Trần cứng (lớp ba) KHÔNG nằm ở đây — nó là hằng trong mã, xem
 * `src/core/rbac/capability-catalog.ts`. Một dòng bật ở bảng này cho một mã
 * đã bị trần cứng chặn vẫn không mở được năng lực đó.
 */
model role_capabilities {
  id              String           @id @default(uuid())
  role_id         String
  capability_code String // A1 … L6, xem đặc tả 02
  scope           capability_scope @default(ORGANIZATION)

  created_at DateTime @default(now()) @db.Timestamptz(3)
  role       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, capability_code])
}

/**
 * Ngoại lệ theo tổ chức, đè lên switchboard của một vai hệ thống mà tổ chức
 * không sở hữu (`roles.organization_id = null`) nên không sửa trực tiếp
 * được. `allowed = true` bật thêm một mã; `allowed = false` tắt một mã đang
 * bật mặc định. Vai riêng của tổ chức không cần dùng bảng này — tổ chức sửa
 * thẳng `role_capabilities` của vai đó.
 * Trần cứng vẫn cắt sau cùng: `allowed = true` cho một mã có trần cứng không
 * bao gồm vai đó không mở được năng lực (`YC-Q3`).
 */
model capability_overrides {
  id              String   @id @default(uuid())
  organization_id String
  role_id         String
  capability_code String
  allowed         Boolean
  updated_by      String
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_role roles @relation("fk_capability_overrides_role_id", fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, role_id, capability_code])
  @@index([organization_id])
  @@index([role_id]) // khoá ngoại cần index (ADR-015 O-1)
}

model memberships {
  id              String            @id @default(uuid())
  organization_id String
  user_id         String
  role_id         String
  branch_id       String? // null = phạm vi toàn tổ chức
  status          membership_status @default(INVITED)
  invited_at      DateTime          @default(now()) @db.Timestamptz(3)
  joined_at       DateTime?         @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_role   roles     @relation("fk_memberships_role_id", fields: [role_id], references: [id], onDelete: Restrict)
  fk_branch branches? @relation("fk_memberships_branch_id", fields: [branch_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, user_id])
  @@index([organization_id])
  @@index([user_id])
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([role_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ── Asset · Job · Usage · Audit — P3 ────────────────────────────────────────
// Đặc tả 07 mục 5–8. Bốn bảng dưới khai organization_id NOT NULL kèm khoá
// ngoại tới organizations ngay từ đầu — không lặp lại nợ #8 của bốn bảng P1.

enum asset_kind {
  ORIGINAL
  ANALYZED
  ENHANCED
  MASTER
  MARKETING
  CATALOG
  LANDING
  SOCIAL
  VIDEO
  RATIO
}

enum asset_state {
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum job_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * Thu hoạch E1 từ bảng `assets` thật của SocialFlow (23 cột), thêm 11 cột —
 * đặc tả 07 mục 5. Asset gốc bất biến (`YC-A1`); dẫn xuất là bản ghi mới, nối
 * bằng `parent_asset_id` và `version` (`YC-A2` `YC-A3`). `generated_flags`
 * không bao giờ mặc định ngầm (`YC-A5`) — `domain/asset-rules.ts` từ chối tạo
 * asset dẫn xuất thiếu cờ này.
 */
model assets {
  id              String      @id @default(uuid())
  organization_id String
  product_id      String? // null ở workspace trải nghiệm
  parent_asset_id String? // phả hệ; asset gốc có null
  kind            asset_kind
  state           asset_state @default(PROCESSING)
  version         Int         @default(1)

  storage_key  String // org/<organization_id>/<product_id>/<asset_id>.<ext>
  thumb_key    String?
  mime_type    String
  width        Int?
  height       Int?
  aspect_ratio String?
  file_size    Int?

  provider         String?
  model            String?
  model_version    String?
  pipeline_version String?
  parameters       Json?
  prompt           String?

  input_sha256    String?
  output_sha256   String?
  quality_score   Float?
  identity_score  Float?
  generated_flags Json? // { generative_fill_used, requires_reshoot_warning }
  cost_usd        Float?

  // P7 — nợ #30 (TECHNICAL_DEBT.md): cột dựng ở P7 để
  // `GET /integration/products/:id/master-image` lọc đúng theo đặc tả 08 mục
  // 4 ("Chỉ ảnh approval_state = APPROVED"). P7 chỉ ĐỌC cột này — P9 (Identity
  // Guard + Cổng 2 Review & Approve, `media.approve`/`I2`) mới là nơi ĐẶT nó.
  // Trước khi P9 xong, cột luôn PENDING nên endpoint tích hợp luôn trả rỗng —
  // đúng luật "ảnh chờ duyệt không rò ra ngoài core" (đặc tả 08 mục 4), không
  // phải một lỗi.
  approval_state approval_state @default(PENDING)

  // P9 — cổng 2 Review & Approve (`media.approve`/`I2`). M04 mục 5.1 đòi ghi
  // rõ AI ai duyệt và lúc nào trên chính bản ghi ảnh, không chỉ ở audit log:
  // audit log trả lời "chuyện gì đã xảy ra", hai cột này trả lời "ảnh này
  // hiện do ai chịu trách nhiệm" mà không phải quét lịch sử.
  approved_by String?
  approved_at DateTime? @db.Timestamptz(3)

  metadata   Json?
  created_by String
  created_at DateTime @default(now()) @db.Timestamptz(3)

  // SDAGF P1 (audit docs/audit/sdagf-2026-10): vòng đời thùng rác thành cột
  // (trước chỉ nằm trong `metadata` JSON, không index, không quét được) và
  // legal hold — còn hạn giữ thì không xoá vĩnh viễn, kể cả cron dọn rác.
  trashed_at       DateTime? @db.Timestamptz(3)
  purge_after      DateTime? @db.Timestamptz(3)
  legal_hold_until DateTime? @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product                products? @relation("fk_assets_product_id", fields: [product_id], references: [id], onDelete: SetNull)
  fk_parent_asset           assets?   @relation("fk_assets_parent_asset_id", fields: [parent_asset_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  assets_by_parent_asset_id assets[]  @relation("fk_assets_parent_asset_id")

  @@index([organization_id])
  @@index([purge_after])
  @@index([organization_id, product_id])
  @@index([parent_asset_id])
  @@index([output_sha256])
  @@index([organization_id, product_id, kind, approval_state])
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Kho dữ liệu v2 (Screen Contract `kho-du-lieu.md` §14 L-1, PO duyệt 29/10/2026):
 * landing page đã sinh được lưu để tìm lại trong Kho dữ liệu. `content` là gói
 * `GeneratedLandingPackage`, `input` là yêu cầu đã gửi (dịp, sản phẩm, chỉ dẫn).
 */
model landing_pages {
  id              String    @id @default(uuid())
  organization_id String
  title           String
  page_type       String?
  occasion_label  String?
  input           Json
  content         Json
  created_by      String
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  // Thùng rác 30 ngày (Kho dữ liệu v2, L-4 — PO 05/11/2026): quá hạn thì cron xoá vĩnh viễn.
  trashed_at      DateTime? @db.Timestamptz(3)
  purge_after     DateTime? @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, created_at])
  @@index([purge_after])
}

/**
 * Đánh giá khách do CHỦ TIỆM tự nhập (PO 30/10/2026) — hiện ở mục "Khách hàng nói gì"
 * trên trang khách Landing (08) / Catalog (09). Không có form khách tự gửi; chỉ dòng
 * `is_visible = true` lên trang công khai. Không lưu số điện thoại khách.
 */
model shop_reviews {
  id              String   @id @default(uuid())
  organization_id String
  author_name     String
  occasion        String?
  rating          Int // 1–5, kiểm ở domain
  comment         String
  is_visible      Boolean  @default(true)
  created_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, is_visible])
}

/**
 * SDAGF P1 — hàng đợi xoá payload trên kho tệp. Xoá dòng `assets` và ghi
 * hàng đợi trong cùng một transaction; cron (`/internal/chain-dispatch-sweep`)
 * mới xoá tệp thật, có thử lại giới hạn. Còn bản ghi khác trỏ tới khoá thì
 * bỏ qua, không xoá.
 */
model storage_outbox {
  id              String    @id @default(uuid())
  organization_id String
  op              String // DELETE
  storage_key     String
  asset_id        String?
  attempts        Int       @default(0)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  done_at         DateTime? @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([op, storage_key])
  @@index([organization_id])
  @@index([done_at, created_at])
}

/**
 * Thu hoạch E2 từ `LocalBudd` (`status` + `step`), thêm trục thứ ba `result`
 * — đặc tả 07 mục 6. Ba trục không gộp (`YC-J1` `YC-J2`).
 * `idempotency_key` không có ở bản đặc tả 07 gốc; thêm ở đây để thực thi
 * `YC-U7` (chống trùng 24 giờ). Lược đồ là nguồn sự thật — tài liệu 07 đã cập
 * nhật theo cùng đợt commit này.
 */
/// Khoá idempotent dùng chung (ROADMAP E5.3): sự kiện đến (webhook, thanh toán) chỉ xử lý một lần
/// theo (tổ chức, phạm vi, khoá). Ghi dòng thành công = được xử lý; trùng → bỏ qua. Dọn sau 30 ngày.
model idempotency_keys {
  id              String   @id @default(uuid())
  organization_id String
  scope           String // vd "webhook.facebook", "webhook.zalo", "payment.<provider>"
  key             String // mã sự kiện của nguồn gửi (message id, transaction id…)
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, scope, key])
  @@index([organization_id])
  @@index([created_at]) // dọn khoá cũ
}

model generation_jobs {
  id              String  @id @default(uuid())
  organization_id String
  workspace_id    String
  branch_id       String?
  user_id         String
  product_id      String?

  feature String // vision.analyze · media.optimize · catalog.generate …
  status  job_status @default(PENDING)
  stage   String? // chỉ có giá trị khi status = PROCESSING
  result  String? // phán quyết nghiệp vụ, độc lập với status

  idempotency_key String? // YC-U7 — duy nhất theo (organization_id, feature)

  // Gom nhiều job cùng một lượt "xuất bộ" của người dùng (vd chạy lô nhiều
  // biến thể M04b, nợ #108) về một màn tiến độ chung — KHÔNG phải khoá
  // nghiệp vụ (mỗi job vẫn có idempotency_key riêng, vẫn trừ credit riêng).
  // NULL cho mọi job không đi qua đường chạy lô, không đổi hành vi cũ.
  job_group_id String?

  // Mã yêu cầu web tạo job (`x-request-id`, ROADMAP E1.1) — nối log web ↔ worker. NULL cho job tạo ngoài request.
  request_id String?

  // E5.1 — lỗi tạm thời được worker tự thử lại sau `run_after` (backoff có ngẫu nhiên, tối đa 3 lần);
  // NULL = chạy ngay. `failure_kind`: RETRYABLE | NEEDS_ACTION (khớp TaskFailureKind phía UI).
  run_after    DateTime? @db.Timestamptz(3)
  failure_kind String?

  payload  Json
  output   Json?
  error    String?
  attempts Int     @default(0)

  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  started_at   DateTime? @db.Timestamptz(3)
  completed_at DateTime? @db.Timestamptz(3)
  cancelled_at DateTime? @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  events       job_events[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_branch    branches?  @relation("fk_generation_jobs_branch_id", fields: [branch_id], references: [id], onDelete: SetNull)
  fk_workspace workspaces @relation("fk_generation_jobs_workspace_id", fields: [workspace_id], references: [id], onDelete: Restrict)
  fk_product   products?  @relation("fk_generation_jobs_product_id", fields: [product_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, feature, idempotency_key])
  @@unique([id, organization_id])
  @@index([organization_id])
  @@index([status, created_at]) // worker quét bằng index này
  @@index([status, run_after]) // job hẹn thử lại (E5.1)
  @@index([organization_id, user_id])
  @@index([organization_id, job_group_id]) // gom màn tiến độ bộ, nợ #108
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([workspace_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Bảng phụ cho nhật ký tiến trình job — đặc tả 05 mục 8: "một bảng phụ theo
 * job_id với số thứ tự tăng dần, không giữ trong bộ nhớ". Tên bảng và cột
 * không có ở đặc tả 07 gốc; đặt ở đây vì lược đồ là nguồn sự thật. Ghi cộng
 * dồn, không sửa/xoá dòng đã ghi. `seq` tăng dần trong phạm vi một job —
 * client nối tiếp qua `Last-Event-ID` (`YC-J9`).
 */
model job_events {
  id              String   @id @default(uuid())
  job_id          String
  /// Sao từ generation_jobs; trigger điền khi bên ghi (worker cũ) bỏ trống.
  organization_id String
  seq             Int
  event           String // stage · log · done
  payload         Json
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  job          generation_jobs @relation(fields: [job_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  organization organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([job_id, seq])
  @@index([organization_id])
}

/**
 * Một bảng usage duy nhất cho toàn hệ thống (`YC-U1` `YC-U2`) — đặc tả 07 mục
 * 7. Ghi tại điểm tạo job phía core, trong cùng giao dịch với kiểm hạn mức và
 * tạo `generation_jobs` (`YC-U3`). Worker không bao giờ ghi bảng này
 * (`YC-U4`).
 */
/// Sổ cái credit (checklist ALG 10.6): mọi thay đổi `organizations.credit_balance` ghi một dòng cùng
/// giao dịch — số dư = tổng `amount`. OPENING: số dư lúc bật sổ; TOPUP: nạp mua; GIFT: tặng;
/// REFUND: hoàn lại (job hỏng, Console hoàn); USAGE: trừ khi dùng (số âm); EXPIRE: credit tặng theo gói còn
/// thừa cuối tháng bị thu hồi (PO Q10). Chỉ ghi thêm.
enum credit_transaction_kind {
  OPENING
  TOPUP
  GIFT
  REFUND
  USAGE
  EXPIRE
}

model credit_transactions {
  id              String                  @id @default(uuid())
  organization_id String
  kind            credit_transaction_kind
  amount          Int // dương = cộng, âm = trừ
  balance_after   Int
  /// AI · SMS · ZNS · CHAT · SUBSCRIPTION — nhóm dịch vụ để báo cáo, null với nạp/tặng
  service         String?
  reason          String?
  /// job_id, mã hoá đơn… để đối soát ngược
  reference       String?
  actor_id        String?
  created_at      DateTime                @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, created_at])
}

/// Gói thuê bao của tổ chức (checklist ALG 10.7, PO Q9). Một tổ chức một thuê bao. Giá theo kỳ nhập ở Console.
/// Kỳ tiếp theo có hoá đơn `subscription_invoices`; tới `current_period_end` mà hoá đơn kỳ sau chưa thu thì
/// tổ chức chuyển sang chỉ xem dữ liệu ngay (không ân hạn). `plan_credit_*`: credit tặng theo gói của tháng.
enum subscription_cycle {
  MONTHLY
  YEARLY
}

enum subscription_status {
  ACTIVE
  OVERDUE
  CANCELLED
}

enum subscription_invoice_status {
  PENDING
  PAID
  VOID
}

model subscriptions {
  id                       String              @id @default(uuid())
  organization_id          String              @unique
  plan                     String // EXPERIENCE · STARTER · PRO · FLOWER_NETWORK · ENTERPRISE
  cycle                    subscription_cycle
  price_vnd                Int
  included_credits_monthly Int                 @default(0)
  status                   subscription_status @default(ACTIVE)
  current_period_start     DateTime            @db.Timestamptz(3)
  current_period_end       DateTime            @db.Timestamptz(3)
  plan_credit_period       String?
  plan_credit_granted      Int                 @default(0)
  created_by               String?
  created_at               DateTime            @default(now()) @db.Timestamptz(3)
  updated_at               DateTime            @updatedAt @db.Timestamptz(3)

  organization organizations           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invoices     subscription_invoices[]

  @@unique([id, organization_id])
  @@index([organization_id])
}

model subscription_invoices {
  id                String                      @id @default(uuid())
  organization_id   String
  subscription_id   String
  /// Mã ghi trong nội dung chuyển khoản để SePay đối soát
  code              String                      @unique
  period_start      DateTime                    @db.Timestamptz(3)
  period_end        DateTime                    @db.Timestamptz(3)
  amount_vnd        Int
  status            subscription_invoice_status @default(PENDING)
  due_at            DateTime                    @db.Timestamptz(3)
  paid_at           DateTime?                   @db.Timestamptz(3)
  /// Mã giao dịch (SePay hoặc xác nhận tay) — chống ghi trùng
  payment_reference String?                     @unique
  reminded_7d       Boolean                     @default(false)
  reminded_1d       Boolean                     @default(false)
  created_at        DateTime                    @default(now()) @db.Timestamptz(3)
  updated_at        DateTime                    @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  // Khoá ghép: hoá đơn và thuê bao cùng tổ chức, Postgres từ chối dòng lệch tổ chức
  subscription subscriptions @relation(fields: [subscription_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([subscription_id, period_start])
  @@index([organization_id])
  @@index([status, due_at])
}

/// Chi phí thật phía nhà cung cấp ngoài AI (checklist ALG 10.4): mỗi tin SMS/ZNS gửi thành công một dòng,
/// theo giá vốn tham chiếu Console nhập. Chi phí AI đọc từ `ai_requests.cost_usd`, không ghi lại ở đây.
model provider_cost_entries {
  id              String   @id @default(uuid())
  organization_id String
  provider        String // ESMS · ZALO_ZNS
  service         String // SMS · ZNS
  cost_usd        Float?
  cost_vnd        Int
  reference       String?
  occurred_at     DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, occurred_at])
}

/// Hạn mức credit theo tháng (checklist ALG 10.3, 9.7, 10.5). `service`: CREDIT = mọi dịch vụ (Console đặt),
/// AI = trần AI do cửa hàng tự đặt. `period`: YYYY-MM giờ Việt Nam; dòng `DEFAULT` giữ mức cấu hình áp cho
/// các tháng sau. `monthly_limit` null = không giới hạn. Cờ cảnh báo bật một lần mỗi kỳ.
model usage_limits {
  id              String   @id @default(uuid())
  organization_id String
  service         String
  period          String
  monthly_limit   Int?
  used            Int      @default(0)
  alerted_near    Boolean  @default(false)
  alerted_low     Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, service, period])
  @@index([organization_id])
}

model usage {
  id              String   @id @default(uuid())
  organization_id String
  workspace_id    String
  user_id         String
  job_id          String?
  feature         String
  quantity        Int      @default(1)
  cost_credit     Int      @default(0)
  cost_usd        Float? // chi phí thật phía nhà cung cấp, để đối soát
  status          String // ENQUEUED · COMPLETED · REFUNDED
  metadata        Json?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_workspace workspaces @relation("fk_usage_workspace_id", fields: [workspace_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at])
  @@index([job_id])
  @@index([workspace_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Nhật ký kiểm toán — đặc tả 07 mục 8. Mọi hành động duyệt sinh một bản ghi
 * (`YC-R4`); bảng dựng ở P3 làm hạ tầng dùng chung — endpoint duyệt đầu tiên
 * gọi tới nó bắt đầu từ M01 (`H3`, P5).
 */
model audit_logs {
  id              String   @id @default(uuid())
  organization_id String
  user_id         String
  action          String // product.approve · media.approve · role.manage …
  entity_type     String
  entity_id       String
  before          Json?
  after           Json?
  ip              String?
  user_agent      String?
  decision_id     String? // Patch v2.3 / P2: Id quyết định theo Decision Registry
  ownership       String? // USER | SYSTEM | SHARED
  decided_by      String? // user_override | user_confirm | system_default | system_rule
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
  @@index([entity_type, entity_id])
}

// ── Hồ sơ kinh doanh và thương hiệu — P4 ────────────────────────────────────
// Đặc tả 07 mục 4. Thu hoạch E3 từ `SocialFlow/backend/brand_kit.py`
// (`brand_config` gộp cả hai làm một). Core tách đôi: hồ sơ kinh doanh là dữ
// liệu pháp lý và liên hệ (đọc/sửa qua F1/F2, dùng chung cho M05 Landing Page
// và tích hợp ngoài); hồ sơ thương hiệu là dữ liệu tạo sinh (màu, font, tông
// giọng, hashtag, CTA — dùng cho M04b/M05/M07). Mỗi tổ chức đúng một bản ghi
// mỗi bảng (`@@unique([organization_id])`) — nhập một lần, dùng lại xuyên
// module (Checklist P4).

model business_profiles {
  id               String   @id @default(uuid())
  organization_id  String
  legal_name       String?
  display_name     String
  /// @pii business
  phone            String?
  /// @pii business
  email            String?
  /// @pii business
  address          String?
  website          String?
  social_links     Json?
  /// @pii business
  tax_code         String?
  description      String?
  operating_hours  Json?
  /// Thông điệp thương hiệu và khách mục tiêu (checklist ALG 9.3) — đưa vào ngữ cảnh AI viết nội dung
  brand_message    String?
  target_customers Json? // danh sách nhóm khách, vd ["Văn phòng tặng sếp", "Cặp đôi"]
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_at       DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id])
}

/**
 * `background_color` và `text_color` có mặt vì `design_contracts` của
 * `LocalBudd` cần đủ bốn màu để dựng landing page — thiếu hai trường này thì
 * M05 phải tự đoán màu nền, và mỗi trang ra một kiểu (đặc tả 07 mục 4).
 * `hashtags`/`cta_templates` là Json vì khác nhau theo nền tảng, đúng hình
 * dạng đã có ở `brand_config.hashtags_<nền tảng>` của SocialFlow.
 */
model brand_profiles {
  id               String   @id @default(uuid())
  organization_id  String
  primary_color    String?
  secondary_color  String?
  accent_color     String?
  background_color String?
  text_color       String?
  font_heading     String?
  font_body        String?
  logo_asset_id    String?
  tone_of_voice    String?
  hashtags         Json? // mảng thẻ hashtag của cửa hàng — hình dạng thật { default: string[] }, đọc qua extractBrandHashtags() (profile-rules.ts, nợ #103)
  cta_templates    Json? // MỘT câu kêu gọi hành động (nợ #102, chốt 17/09) — hình dạng thật { default: string } do brand-profile-form.tsx ghi, đọc qua extractBrandCtaPhrase() (profile-rules.ts, nợ #103). KHÔNG còn chứa free_gifts/guarantees
  default_offers   Json? // { free_gifts?: string[], guarantees?: string[] } — tách khỏi cta_templates (nợ #102, 17/09):
  // trước đây `SalesDefaultsForm` ghi nhầm free_gifts/guarantees vào cta_templates, xung đột
  // với product-copy-adapter.ts coi cta_templates là string[] câu CTA. Đọc có dự phòng dữ
  // liệu cũ trong cta_templates cho tổ chức đã lưu trước 17/09 — xem sales-defaults-form.tsx.
  forbidden_styles Json?
  brand_assets     Json? // { storefront_photos?: string[], intro_video?: string, qr_code?: string } — Nguyên liệu thương hiệu cấp Tiệm (Master Assets, đặc tả FLORAOS_BUSINESS_PROFILE_AND_INPUT_SPEC mục 4.1)
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_at       DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id])
}

// ── P5 — Sản phẩm và phân tích ảnh (M01) ────────────────────────────────────
// Thu hoạch từ đặc tả 07 mục 9. Bốn bảng Product Master + kết quả phân tích.
// Có khoá ngoại `organizations` ngay từ đầu — không lặp lại nợ #8 của P3
// (`TECHNICAL_DEBT.md` #8: bốn bảng thuộc tenant của P3 thiếu khoá ngoại vì
// đặc tả 07 mục 3 khai `organization_id` là cột thường lúc đó).

// PAUSED: tạm ngưng nhận đơn (PO 04/11/2026, checklist ALG 2.3) — ẩn khỏi link khách, mở bán lại bất cứ lúc nào.
enum product_status {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/**
 * Trạng thái còn hàng của MẪU sản phẩm dựng sẵn tại một chi nhánh (P-Fix-3a, 17/09).
 */
enum stock_status {
  IN_STOCK
  PRE_ORDER_ONLY
  OUT_OF_STOCK
}

enum approval_state {
  PENDING
  APPROVED
  REJECTED
}

model products {
  id                  String         @id @default(uuid())
  organization_id     String
  branch_id           String?
  code                String
  name                String
  category            String? // enum identity.category của hợp đồng Vision — Schema.json, không khai lại tay
  shape               String?
  facing              String?
  container           String?
  status              product_status @default(DRAFT)
  attributes          Json?
  /**
   * Cấu hình kiểm tra khả dụng theo ngành (PO 18/10/2026). Xem product-availability-config.ts.
   */
  availability_config Json?
  /// Trường bán hàng chuẩn (PO 30/10/2026, công cụ 53 giai đoạn 5) — tuỳ chọn, null khi chưa khai.
  barcode             String?
  cost_price_vnd      Int?
  vat_percent         Int?
  weight_grams        Int?
  tags                String[]       @default([])
  created_at          DateTime       @default(now()) @db.Timestamptz(3)
  updated_at          DateTime       @updatedAt @db.Timestamptz(3)

  organization              organizations               @relation(fields: [organization_id], references: [id])
  variants                  product_variants[]
  images                    product_images[]
  analyses                  product_analyses[]
  inventory                 product_inventory[]
  bookings                  product_bookings[]
  greeting_catalog_products greeting_catalog_products[]
  change_requests           product_change_requests[]
  revisions                 product_revisions[]
  recipes                   product_recipes[]
  quotation_items           quotation_items[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_branch                                branches?                 @relation("fk_products_branch_id", fields: [branch_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  assets_by_product_id                     assets[]                  @relation("fk_assets_product_id")
  generation_jobs_by_product_id            generation_jobs[]         @relation("fk_generation_jobs_product_id")
  product_copies_by_product_id             product_copies[]          @relation("fk_product_copies_product_id")
  video_jobs_by_product_id                 video_jobs[]              @relation("fk_video_jobs_product_id")
  order_items_by_product_id                order_items[]             @relation("fk_order_items_product_id")
  campaign_packages_by_product_id          campaign_packages[]       @relation("fk_campaign_packages_product_id")
  content_generations_by_product_id        content_generations[]     @relation("fk_content_generations_product_id")
  greeting_sessions_by_selected_product_id greeting_sessions[]       @relation("fk_greeting_sessions_selected_product_id")
  greeting_catalog_events_by_product_id    greeting_catalog_events[] @relation("fk_greeting_catalog_events_product_id")
  sales_channel_listings_by_product_id     sales_channel_listings[]  @relation("fk_sales_channel_listings_product_id")

  @@unique([organization_id, code])
  @@unique([id, organization_id]) // đích của khoá ghép tenant (05/11/2026)
  @@index([organization_id])
  @@index([organization_id, barcode])
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Đề xuất sửa một mẫu CHÍNH THỨC của người không có `H3` (quản trị danh mục, giai đoạn 3 —
/// `docs/dac-ta/FLORAOS_PRODUCT_CATALOG_GOVERNANCE_SPEC.md` mục 6). Bản gốc không đổi tới khi
/// Điều hành duyệt; `base_updated_at` phát hiện bản gốc đã đổi sau lúc gửi (xung đột, không tự gộp).
model product_change_requests {
  id              String    @id @default(uuid())
  organization_id String
  product_id      String
  proposed_by     String
  changes         Json // tập con trường của PATCH /products/:id (đã bỏ khoá chỉ máy chủ ghi)
  base_updated_at DateTime  @db.Timestamptz(3)
  status          String    @default("PENDING") // PENDING | APPROVED | PARTIAL | REJECTED | EXPIRED
  applied_fields  Json? // các trường Điều hành chọn áp dụng khi duyệt một phần
  reviewed_by     String?
  reviewed_at     DateTime? @db.Timestamptz(3)
  note            String?
  expires_at      DateTime  @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, product_id])
}

/// Ảnh chụp nội dung mẫu TRƯỚC mỗi lần đổi nội dung mẫu chính thức (Điều hành sửa, duyệt đề xuất
/// sửa, nhập Excel cập nhật, khôi phục) — để khôi phục và hoàn tác lô nhập.
model product_revisions {
  id              String   @id @default(uuid())
  organization_id String
  product_id      String
  snapshot        Json // name, code, category, shape, facing, container, status, attributes, availability_config
  reason          String // EDIT | CHANGE_REQUEST | IMPORT | RESTORE
  actor_id        String
  import_batch_id String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_import_batch product_import_batches? @relation("fk_product_revisions_import_batch_id", fields: [import_batch_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([organization_id, product_id, created_at])
  @@index([organization_id, import_batch_id])
  @@index([import_batch_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Một lần Điều hành nhập Excel — hoàn tác được trong 24 giờ (mẫu tạo ra vào thùng rác,
/// mẫu bị cập nhật trả về `product_revisions` cùng `import_batch_id`).
model product_import_batches {
  id              String    @id @default(uuid())
  organization_id String
  created_by      String
  created_ids     Json // string[]
  updated_ids     Json // string[]
  undone_at       DateTime? @db.Timestamptz(3)
  undone_by       String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  product_revisions_by_import_batch_id product_revisions[] @relation("fk_product_revisions_import_batch_id")

  @@index([organization_id])
  @@index([organization_id, created_at])
}

model product_variants {
  id              String  @id @default(uuid())
  organization_id String
  product_id      String
  name            String
  size            String?
  multiplier      Float   @default(1)
  attributes      Json?
  /// SKU/mã vạch theo biến thể (PO 30/10/2026) — SKU duy nhất trong một tổ chức khi đã khai.
  sku             String?
  barcode         String?

  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id, organization_id], references: [id, organization_id])

  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  order_items_by_variant_id order_items[] @relation("fk_order_items_variant_id")

  @@unique([organization_id, sku])
  @@index([organization_id, product_id])
}

model product_images {
  id              String @id @default(uuid())
  organization_id String
  product_id      String
  asset_id        String
  role            String // MAIN · GALLERY · CATALOG · SOCIAL
  position        Int    @default(0)

  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id, organization_id], references: [id, organization_id])

  @@unique([organization_id, product_id, asset_id, role])
  @@index([organization_id, product_id])
}

/**
 * Tồn kho MẪU SẢN PHẨM (bó/giỏ dựng sẵn) theo từng chi nhánh — KHÔNG phải tồn kho nguyên
 * liệu hoa rời (chốt với chủ sản phẩm 17/09, xem TECHNICAL_DEBT.md mục P-Fix-3a và
 * `product-master-index.ts`, `ProductMasterIndex.stock`).
 * `branch_id` BẮT BUỘC (không nullable) — mỗi dòng gắn với đúng một chi nhánh cụ thể, tránh
 * hẳn cái bẫy Postgres coi mọi NULL là phân biệt (nợ #7, đã ghi trong TECHNICAL_DEBT.md) mà
 * một `branch_id` tuỳ chọn sẽ vướng phải nếu dùng `@@unique` thông thường.
 */
model product_inventory {
  id                 String       @id @default(uuid())
  organization_id    String
  product_id         String
  branch_id          String
  status             stock_status @default(IN_STOCK)
  quantity_available Int?
  updated_at         DateTime     @updatedAt @db.Timestamptz(3)

  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id, organization_id], references: [id, organization_id])
  branch       branches      @relation(fields: [branch_id], references: [id])

  @@unique([organization_id, product_id, branch_id])
  @@index([organization_id, branch_id])
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Lịch đặt chỗ theo ngành Homestay (BOOKING_CALENDAR mode) và các ngành có không gian theo
 * khoảng ngày. Mỗi dòng tương ứng một kỳ nghỉ / đặt chỗ / block thủ công.
 * `order_id = null` = admin block thủ công (bảo trì, dọ phòng...).
 */
/// Trạng thái đặt chỗ — enum từ 22/10/2026 (rà soát M5), trước đó là chuỗi tự do.
enum booking_status {
  ACTIVE
  CANCELLED
}

model product_bookings {
  id              String         @id @default(uuid())
  organization_id String
  product_id      String
  order_id        String? // null = admin block thủ công
  check_in_date   DateTime       @db.Date // code dùng "YYYY-MM-DD" — đổi ở biên repository (booking-day.ts)
  check_out_date  DateTime       @db.Date // exclusive — ngày check-out không được tính
  note            String? // "Bảo trì", "Sửa chữa", null = đặt từ đơn khách
  status          booking_status @default(ACTIVE)
  created_at      DateTime       @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  product      products      @relation(fields: [product_id], references: [id])
  // Xoá đơn (chỉ khi dọn tenant bàn giao) thì xoá luôn đặt chỗ sinh từ đơn đó
  order        orders?       @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([organization_id, product_id, check_in_date])
  @@index([organization_id, product_id, status])
  @@index([organization_id, order_id])
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Kết quả phân tích ảnh — `raw` và `edited` tách rời tuyệt đối (đặc tả 07
 * mục 9, `YC-R3`). `raw` là dự đoán gốc của máy theo đúng hợp đồng
 * `PhanTichSanPhamHoa` (`workers/vision/contracts/Schema.json`, R1), không
 * bao giờ bị ghi đè. `edited` là bản người sửa trước khi duyệt (`PATCH
 * /vision/analyses/:id`, `H2`) — dữ liệu huấn luyện tương lai nằm ở cặp
 * *raw/edited* này, không được gộp làm một.
 * `product_id` để trống khi phân tích chưa gắn vào sản phẩm nào (`POST
 * /vision/analyses` cho phép `product_id: null`, đặc tả 06 mục 8) —
 * `approveAnalysis` tạo `products` mới trong trường hợp đó (xem
 * `use-cases/approve-analysis.ts`).
 */
model product_analyses {
  id              String  @id @default(uuid())
  organization_id String
  product_id      String?
  asset_id        String
  job_id          String

  provider         String
  model            String
  model_version    String
  contract_name    String // "PhanTichSanPhamHoa"
  contract_version String

  raw            Json // dự đoán gốc của máy, bất biến
  edited         Json? // bản người sửa, lưu tách biệt
  approval_state approval_state @default(PENDING)
  approved_by    String?
  approved_at    DateTime?      @db.Timestamptz(3)

  created_at DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  product      products?     @relation(fields: [product_id], references: [id])

  // Một ảnh chỉ có đúng một kết quả trong một lượt job. Không có ràng buộc
  // này thì một job lô hỏng giữa chừng rồi chạy lại (`POST /jobs/:id/retry`)
  // sẽ ghi lần hai cho những ảnh đã phân tích xong ở lần trước — hàng chờ
  // duyệt nhân đôi, và người duyệt không biết bản nào là bản nên duyệt.
  // Worker dựa vào chính ràng buộc này để chạy lại an toàn (`ON CONFLICT`).
  @@unique([job_id, asset_id])
  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([job_id])
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Bảng dựng cùng đợt vì đặc tả 07 mục 9 khai chung một khối lược đồ với
 * `products`, nhưng **logic giá (M02) thuộc P6, chưa xây ở đây** — bảng này
 * đứng rỗng cho tới khi P6 bắt đầu, đúng luật "core sở hữu entity nhiều
 * module đọc" (kiến trúc V2 mục 2.1), không phải một ngoại lệ nhảy pha.
 */
model pricing_rules {
  id              String   @id @default(uuid())
  organization_id String
  branch_id       String?
  key             String // san · tran · muc_thu · lam_tron …
  value           Json
  effective_from  DateTime @default(now()) @db.Timestamptz(3)
  created_by      String

  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_branch branches? @relation("fk_pricing_rules_branch_id", fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([organization_id, key])
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ── Integration Layer — P7 ───────────────────────────────────────────────
// Đặc tả 06 mục 11, đặc tả 08. Token máy gọi máy cho `LocalBudd` (M05/M06) và
// `SocialFlow` (M04b/M07) — YC-T8.

enum integration_client {
  LOCALBUDD
  SOCIALFLOW
}

/**
 * Core ký (HMAC, `INTEGRATION_TOKEN_SECRET`) và chỉ giữ `token_hash`, không
 * giữ giá trị token thật — cùng quy ước với `sessions.token_hash`
 * (`session-token.ts`). Phạm vi quyền KHÔNG đi qua 114 mã năng lực của người
 * dùng: nó cố định theo `client` (đặc tả 08 mục 4) và áp thẳng trong từng
 * route `/api/v1/integration/*` — token không phải một vai giao diện, nên
 * không có hàng trong `role_capabilities`/`capability_overrides`.
 * Xoay không dừng dịch vụ (đặc tả 08 mục 3): `rotated_from_id` nối token mới
 * tới token cũ, nhưng tạo token mới KHÔNG tự thu hồi token cũ — core chấp
 * nhận cả hai cùng lúc cho tới khi người quản trị tự thu hồi token cũ qua
 * `DELETE /integration-tokens/:id` (`F9`).
 */
model integration_tokens {
  id              String             @id @default(uuid())
  organization_id String
  client          integration_client
  token_hash      String             @unique
  created_by      String
  created_at      DateTime           @default(now()) @db.Timestamptz(3)
  expires_at      DateTime           @db.Timestamptz(3)
  revoked_at      DateTime?          @db.Timestamptz(3)
  rotated_from_id String?

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_rotated_from                       integration_tokens?  @relation("fk_integration_tokens_rotated_from_id", fields: [rotated_from_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  integration_tokens_by_rotated_from_id integration_tokens[] @relation("fk_integration_tokens_rotated_from_id")

  @@index([organization_id])
  @@index([organization_id, client])
  @@index([rotated_from_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Số liệu hiệu quả nội dung — ghi từ engine ngoài (SocialFlow/LocalBudd) qua Integration API.
/// Idempotent theo khoá tự nhiên: (organization_id, platform, content_id, metric_date).
model content_metrics {
  id              String   @id @default(uuid())
  organization_id String
  platform        String
  content_id      String
  metric_date     DateTime @db.Date

  reach       Int?
  impressions Int?
  engagement  Int?
  clicks      Int?
  conversions Int?
  spend_usd   Float?

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, platform, content_id, metric_date])
  @@index([organization_id])
  @@index([organization_id, metric_date])
}

// ── Nền AI — AI-1 ───────────────────────────────────────────────────────────

/// Sổ đăng ký năng lực. Nội dung nạp từ `src/core/ai/domain/ai-capabilities.ts`
/// (nguồn sự thật của định nghĩa, cùng lối với `capability-catalog.ts`); bảng
/// giữ phần vận hành sửa được: ngưỡng chấp nhận và bật tắt.
model ai_capabilities {
  code             String           @id
  module           String
  kind             String // generative · measuring · deterministic
  needs_approval   Boolean          @default(true)
  privacy_floor    ai_privacy_level @default(SHOP)
  accept_threshold Float? // null = chưa đo được (D20). Cổng AI chấm, ghi, KHÔNG chặn.
  measure_channels Json
  enabled          Boolean          @default(true)
  updated_at       DateTime         @updatedAt @db.Timestamptz(3)

  created_at DateTime      @default(now()) @db.Timestamptz(3)
  policies   ai_policies[]
}

/// Sổ đăng ký mô hình. Bốn cột giấy phép KHÔNG cho phép rỗng vì lý do pháp lý,
/// không vì lý do kỹ thuật (D18): mô hình thiếu một ô thì không bật được.
model ai_models {
  id             String           @id @default(uuid())
  key            String           @unique
  display_name   String
  provider       String
  mode           ai_mode
  capabilities   Json // mã năng lực nó phục vụ
  license        String
  commercial_use Boolean
  territory      String
  allowed_use    String
  cost_class     String
  latency_class  String
  quality_class  String
  measure_state  ai_measure_state @default(CHUA_DO)
  leaves_infra   Boolean // ảnh có rời hạ tầng không
  enabled        Boolean          @default(false)
  version        String
  registered_by  String?
  created_at     DateTime         @default(now()) @db.Timestamptz(3)
  updated_at     DateTime         @updatedAt @db.Timestamptz(3)
}

/// Chính sách của tổ chức — TRẦN mà bộ định tuyến được chọn trong đó (D17),
/// không phải một lựa chọn duy nhất.
model ai_policies {
  id              String           @id @default(uuid())
  organization_id String
  capability_code String
  allowed_models  Json // mảng key của ai_models
  quality_target  String?
  cost_ceiling    Int? // credit mỗi lượt
  privacy_floor   ai_privacy_level
  updated_by      String
  updated_at      DateTime         @updatedAt @db.Timestamptz(3)

  created_at   DateTime        @default(now()) @db.Timestamptz(3)
  organization organizations   @relation(fields: [organization_id], references: [id])
  capability   ai_capabilities @relation(fields: [capability_code], references: [code])

  @@unique([organization_id, capability_code])
  @@index([organization_id])
  @@index([capability_code]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Sổ chi phí và chất lượng mỗi LỜI GỌI mô hình. Chỉ ghi thêm. Không giữ
/// prompt lẫn đầu ra — prompt của một lượt sinh nằm ở metadata của asset.
/// Một lượt nghiệp vụ sinh nhiều hàng khi thác nghiệm leo hoặc dự phòng chạy.
model ai_requests {
  id               String   @id @default(uuid())
  organization_id  String
  job_id           String?
  capability_code  String
  model_key        String
  attempt          Int      @default(1)
  escalated_from   String?
  fallback_from    String?
  source           String // CORE · LOCALBUDD · SOCIALFLOW
  input_tokens     Int?
  output_tokens    Int?
  image_count      Int?
  duration_seconds Float?
  gpu_seconds      Float?
  cost_usd         Float? // cùng kiểu với usage.cost_usd
  latency_ms       Int?
  quality_score    Float?
  outcome          String // ACCEPTED · ESCALATED · FAILED · NEEDS_REVIEW
  created_at       DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
  @@index([organization_id, capability_code, model_key])
  @@index([job_id])
}

/// Điểm chấm của một đầu ra AI. `needs_review` là cờ đưa bản ghi vào hàng chờ
/// duyệt; nó KHÔNG thay Review → Approve và không thay Identity Guard.
model ai_evaluations {
  id              String   @id @default(uuid())
  organization_id String
  capability_code String
  entity_type     String // product_analysis · product_copy · asset · post …
  entity_id       String
  scores          Json // một khoá cho mỗi kênh đã khai ở ai_capabilities
  overall_score   Float
  threshold_used  Float?
  needs_review    Boolean  @default(false)
  reason          String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, entity_type, entity_id])
  @@index([organization_id, capability_code])
}

/**
 * Giọng theo dịp (nợ #104, 18/09) — Tony chốt qua AskUserQuestion 17/09: xây
 * đầy đủ ("làm đầy đủ luôn"), không phải một lát cắt nhỏ trước. Ba giá trị
 * đóng, do TENANT tự gán cho từng dịp qua UI quản lý — hệ thống KHÔNG suy
 * đoán "trang trọng" từ tên dịp bằng từ khoá (đúng nguyên tắc "không bịa" đã
 * áp dụng cho `tone_of_voice`/`cta_templates`, nợ #102/#103).
 */
enum occasion_register {
  FESTIVE
  NEUTRAL
  SOLEMN
}

/// Danh mục dịp — nạp 6 dòng mặc định khi tạo tổ chức (P19, nợ #63).
/// SỬA 18/09 (nợ #104): dòng chú thích cũ ở đây ghi "`dip_su_dung` của
/// product_copies gán theo mã trong bảng này, không phải chuỗi tự do" — đọc
/// thẳng mã thật (sales-pitch-template.ts, product-master-index-repository.ts,
/// mergeOccasions()) cho thấy điều này SAI: `identity.dip_su_dung` luôn là
/// CHUỖI TỰ DO (AI đoán hoặc Sales gõ tay), không có cột nào tham chiếu
/// `occasions.code`. Có thể là định hướng ban đầu chưa từng cài — xoá khẳng
/// định sai thay vì lặp lại nó.
/// Từ nợ #104 (18/09): tenant tự thêm/sửa/tắt dịp qua UI (`OccasionRepository.create/update`),
/// và mỗi dịp mang một `register` để suy ra tông giọng kịch bản Zalo (khớp CHÍNH XÁC
/// theo TÊN dịp với `pitch.occasions[0]`, không phải qua `code`) — xem `occasion-rules.ts`.
model occasions {
  id              String            @id @default(uuid())
  organization_id String
  code            String
  name            String
  sort_order      Int               @default(0)
  is_active       Boolean           @default(true)
  /**
   * Tông giọng khi dịp này được dùng để sinh kịch bản Zalo (nợ #104).
   */
  register        occasion_register @default(FESTIVE)
  created_at      DateTime          @default(now()) @db.Timestamptz(3)
  updated_at      DateTime          @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, code])
  @@index([organization_id])
}

enum template_family {
  GT
  IT
  CT
  ST
  OT
}

/// Ghi đè template theo tenant (nợ #99, Giai đoạn 3 kiến trúc gốc —
/// FLORAOS_TEMPLATE_ENGINE_ARCHITECTURE.md §3, cơ chế kế thừa 2 lớp: System
/// Golden Template -> Tenant Override). BẢNG RIÊNG, không mở rộng
/// `brand_profiles` — quyết định anh Tony 17/09, giữ nguyên sau khi cân nhắc
/// lại 18/09 theo đề xuất kiến trúc: đúng nguyên tắc Atomic Disaggregated
/// Fields (AGENTS.md 1.3), mỗi dòng là MỘT trường ghi đè nguyên tử, tránh lặp
/// lại lỗi hình dạng cột Json không khoá đã gặp ở nợ #102 (`cta_templates`
/// từng mang hai nghĩa xung đột trong cùng một cột, không ai phát hiện kịp).
/// Phạm vi khởi điểm 18/09: domain layer (`template-override-rules.ts`) CHỈ
/// chấp nhận đúng một field đã có nơi đọc thật — (`ST`, `sales_pitch_zalo`,
/// `greeting_line`). Không suy đoán thêm field/template nào khác chưa được
/// xác nhận — mở danh sách trắng đó CÙNG LÚC với khi thêm nơi đọc thật.
model template_overrides {
  id              String          @id @default(uuid())
  organization_id String
  template_family template_family
  template_key    String
  field_key       String
  value           String
  updated_by      String
  created_at      DateTime        @default(now()) @db.Timestamptz(3)
  updated_at      DateTime        @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, template_key, field_key])
  @@index([organization_id])
}

/// Liên kết catalog chia sẻ — slug unique toàn cục, thu hồi được, không xoá.
/// LocalBudd đọc qua Integration API để render trang catalog công khai.
model catalog_links {
  id              String    @id @default(uuid())
  organization_id String
  slug            String    @unique
  name            String
  description     String?
  filters         Json?
  is_revoked      Boolean   @default(false)
  revoked_at      DateTime? @db.Timestamptz(3)
  revoked_by      String?
  created_by      String
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  // Thùng rác 30 ngày (Kho dữ liệu v2, L-4 — PO 05/11/2026): quá hạn thì cron xoá vĩnh viễn.
  trashed_at      DateTime? @db.Timestamptz(3)
  purge_after     DateTime? @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([slug])
  @@index([purge_after])
}

/// Công cụ 11 — link công khai của hồ sơ cửa hàng (/ch/<slug>). Mỗi tổ chức tối đa
/// một link đang hoạt động (kiểm ở use-case); link cũ thu hồi được, không xoá, để
/// link đã phát ra trả "đã ngừng" thay vì 404 lẫn với link sai.
model store_share_links {
  id              String    @id @default(uuid())
  organization_id String
  slug            String    @unique
  is_revoked      Boolean   @default(false)
  revoked_at      DateTime? @db.Timestamptz(3)
  revoked_by      String?
  view_count      Int       @default(0)
  created_by      String
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, is_revoked])
}

/// Công cụ 45 — thư viện nhận diện thương hiệu có phiên bản. Chuỗi bật
/// `share_with_members` để cửa hàng thành viên (liên kết chuỗi ACTIVE ở organization_links) xem và tải;
/// cửa hàng chỉ đọc, không sửa. Không xoá cứng: lưu trữ (ARCHIVED) để giữ lịch sử.
model brand_library_items {
  id                 String   @id @default(uuid())
  organization_id    String
  title              String
  category           String // LOGO | COLOR | FONT | IMAGE | TEMPLATE | GUIDELINE | COPY
  description        String?
  share_with_members Boolean  @default(false)
  status             String   @default("ACTIVE") // ACTIVE | ARCHIVED
  current_version    Int      @default(1)
  created_by         String
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @updatedAt @db.Timestamptz(3)

  organization organizations            @relation(fields: [organization_id], references: [id])
  versions     brand_library_versions[]

  @@unique([id, organization_id])
  @@index([organization_id])
  @@index([organization_id, status])
}

/// Mỗi lần thay nội dung một tài nguyên là một phiên bản mới; bản cũ giữ nguyên.
model brand_library_versions {
  id              String   @id @default(uuid())
  organization_id String
  item_id         String
  version         Int
  asset_id        String? // ảnh trong `assets` của chính tổ chức
  text_value      String? // mã màu, tên phông, câu chữ, hướng dẫn
  note            String?
  created_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  // Khoá ghép: phiên bản luôn cùng tổ chức với mục cha (rà soát CSDL 05/11/2026).
  item         brand_library_items @relation(fields: [item_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([item_id, version])
  @@index([organization_id])
}

// ── M01b — Product Sales Data (Tên, Mô tả, Thẻ, Phân khúc giá) ────────────────
// P14: Dữ liệu bán hàng sinh từ lượt phân tích đã duyệt. `raw`/`edited` tách rời
// (YC-R3). `analysis_id` trỏ tới `product_analyses` đã APPROVED.
// Duyệt (`H6`) ghi Product Master + `audit_logs` trong một giao dịch.
model product_copies {
  id              String  @id @default(uuid())
  organization_id String
  analysis_id     String // bắt buộc: product_analyses đã APPROVED
  product_id      String? // null khi phân tích chưa gắn sản phẩm (sẽ tạo mới khi duyệt)

  // Dự đoán gốc của máy (bất biến) — keys: suggested_name, suggested_description,
  // suggested_tags[], suggested_occasions[], suggested_price_segment
  raw            Json
  // Bản người sửa trước khi duyệt (PATCH /product-copies/:id, H5)
  edited         Json?
  approval_state approval_state @default(PENDING)
  approved_by    String?
  approved_at    DateTime?      @db.Timestamptz(3)

  // Phiên bản hồ sơ phong cách đã dùng (learning_profiles.version), để truy xuất
  profile_version String?

  // Lý do từ chối — CỘT RIÊNG, không nhét vào `edited`. `edited` là bản sửa
  // của người theo hình dạng câu chữ bán hàng; trộn một khoá quản trị vào đó
  // làm `resolveEffective` phải phân biệt hai loại khoá trong cùng một object.
  reject_reason String?

  // Truy vết lượt gọi mô hình đã sinh ra bản này — PRD mục 9, nhóm "Truy vết".
  // Không có bốn cột này thì không đối soát được chi phí, không so sánh được
  // hai mô hình, và không biết bản nào sinh ra bởi mô hình nào khi đổi mô hình.
  job_id     String?
  model_key  String?
  provider   String?
  cost_usd   Float?
  latency_ms Int?

  created_at DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products? @relation("fk_product_copies_product_id", fields: [product_id], references: [id], onDelete: SetNull)

  @@unique([analysis_id]) // một lượt phân tích chỉ tạo một product_copy
  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([approval_state])
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ── M04c — AI Video Studio (Reel, TikTok, Story, Slideshow) ─────────────────

enum video_format {
  REEL_15S
  TIKTOK_30S
  STORY_15S
  SLIDESHOW
  PRODUCT_PAGE
  AD_MOTION
}

enum video_stage {
  DRAFT
  SCRIPT_GENERATING
  SCRIPT_READY
  SCRIPT_APPROVED
  RENDERING
  RENDER_COMPLETED
  APPROVED
  REJECTED
  FAILED
}

model video_jobs {
  id              String       @id @default(uuid())
  organization_id String
  product_id      String?
  title           String
  format          video_format
  stage           video_stage  @default(DRAFT)

  // Cổng duyệt 1: Kịch bản (Script / Storyboard)
  script_approval    approval_state @default(PENDING)
  script_approved_at DateTime?      @db.Timestamptz(3)
  script_approved_by String?

  // Cổng duyệt 2: Video kết quả (Final Render)
  video_approval    approval_state @default(PENDING)
  video_approved_at DateTime?      @db.Timestamptz(3)
  video_approved_by String?

  // Cấu hình video
  duration_seconds Int     @default(15)
  aspect_ratio     String  @default("9:16")
  music_track      String?
  voice_code       String?
  has_subtitle     Boolean @default(true)
  caption_style    String  @default("MODERN_BADGE")
  has_watermark    Boolean @default(false)

  // Đợt 4 (24/09/2026): video lắp từ KỊCH BẢN SẢN XUẤT TỔNG + bản phối Khu vực C.
  // Có `audio_storage_key` thì worker dùng nguyên bản phối, không đọc lại TTS.
  scene_plan_id       String?
  scene_plan_revision Int?
  audio_job_id        String?
  audio_storage_key   String?

  // Tài sản đầu ra & Hạch toán
  final_video_url String?
  final_asset_id  String?
  // Kho dữ liệu v2: người tạo để phân loại theo chi nhánh; job cũ null (tính là trụ sở).
  created_by      String?
  cost_credits    Int     @default(0)
  error_message   String?

  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  // Thùng rác 30 ngày (Kho dữ liệu v2, L-4 — PO 05/11/2026): quá hạn thì cron xoá vĩnh viễn.
  trashed_at  DateTime? @db.Timestamptz(3)
  purge_after DateTime? @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations  @relation(fields: [organization_id], references: [id])
  scenes       video_scenes[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products? @relation("fk_video_jobs_product_id", fields: [product_id], references: [id], onDelete: SetNull)

  @@unique([id, organization_id])
  @@index([organization_id])
  @@index([organization_id, product_id])
  @@index([stage])
  @@index([script_approval])
  @@index([video_approval])
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([purge_after])
}

model video_scenes {
  id                String   @id @default(uuid())
  video_job_id      String
  /// Sao từ video_jobs; trigger điền khi bên ghi bỏ trống.
  organization_id   String
  scene_index       Int
  duration_seconds  Float    @default(3.0)
  image_asset_id    String?
  text_overlay      String?
  voice_script      String?
  transition_effect String?  @default("fade")
  /// Ken Burns (ZOOM_IN | ZOOM_OUT | PAN_UP | PAN_RIGHT | STATIC) — 23/09/2026:
  /// trước đó lựa chọn ở Khu vực E không được lưu, worker luôn tự xoay vòng.
  motion_effect     String?
  created_at        DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  job          video_jobs    @relation(fields: [video_job_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([video_job_id, scene_index])
  @@index([video_job_id])
  @@index([organization_id])
}

// ── M10 — Đơn hàng và vận hành (P22) ────────────────────────────────────────

enum order_status {
  DRAFT
  CONFIRMED
  PROCESSING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum production_status {
  WAITING
  ASSIGNED
  ARRANGING
  QUALITY_CHECK
  READY
}

enum delivery_status {
  PENDING
  DISPATCHED
  DELIVERING
  DELIVERED
  FAILED
}

model orders {
  id                String            @id @default(uuid())
  organization_id   String
  branch_id         String?
  code              String
  customer_id       String?
  status            order_status      @default(DRAFT)
  production_status production_status @default(WAITING)
  delivery_status   delivery_status   @default(PENDING)

  total_vnd        Decimal @db.Decimal(14, 2)
  /// ĐP-4a (26/09/2026) — Sổ thu (PO 26/09, D2). Tổng đã thu, cập nhật CÙNG
  /// giao dịch với mỗi dòng `order_payments`. Đơn cũ (trước ĐP-4a): 0, gán
  /// trong migration.
  paid_vnd         Decimal @default(0) @db.Decimal(14, 2)
  /// Còn phải thu = total_vnd − paid_vnd. Máy chủ ghi, không ai sửa tay.
  /// KHÔNG có ràng buộc CHECK ở tầng Prisma (xem migration.sql của
  /// `..._coordinator_p1_p2_payments` — CHECK viết tay ở SQL thô, `prisma db
  /// push` không đẩy được ràng buộc CHECK, chỉ `migrate deploy` mới đẩy).
  /// Đơn cũ: gán = total_vnd trong migration (chưa thu gì).
  balance_vnd      Decimal @db.Decimal(14, 2)
  pricing_rule_ref Json? // quy tắc giá đã dùng, để đối soát
  voucher_id       String?
  card_message     String? // lời nhắn thiệp, tách khỏi ghi chú nội bộ
  internal_note    String?
  delivery_window  Json? // ngày và khung giờ đã hẹn
  /// @pii address
  delivery_address Json?

  /// Hoá đơn VAT (PO 15/10/2026). Bật VAT → total_vnd = giá trước thuế + vat_amount_vnd.
  /// Máy chủ tính, không ai sửa tay. vat_rate chỉ 8 hoặc 10 (%).
  vat_enabled    Boolean @default(false)
  vat_rate       Int     @default(10)
  vat_amount_vnd Decimal @default(0) @db.Decimal(14, 2)
  // Bên mua hoá đơn (tên công ty, MST, địa chỉ, email) ở `order_recipients` (ADR-014 P-3c, 07/11/2026).

  created_by String
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  organization      organizations           @relation(fields: [organization_id], references: [id])
  customer          customers?              @relation(fields: [customer_id], references: [id])
  items             order_items[]
  assignments       order_assignments[]
  events            order_events[]
  coordination      order_coordinations?
  qc_records        order_qc_records[]
  exceptions        order_exceptions[]
  payments          order_payments[]
  info_requests     order_info_requests[]
  change_requests   order_change_requests[]
  recipient         order_recipients?
  shared_access     shared_order_access[]
  bookings          product_bookings[]
  source            String?                 @default("MANUAL") // mã ở src/modules/orders/domain/order-source.ts
  source_session_id String? // greeting_sessions.id
  greeting_sessions greeting_sessions[]

  /// Đơn hàng đa nguồn (PO 31/10/2026, KIEN_TRUC_SSOT_DON_HANG_DA_NGUON.md §4.1). Chỉ THÊM —
  /// đơn Thẻ chào không đọc các cột này (sale phụ trách vẫn suy từ greeting_sessions.sale_id).
  /// Sale phụ trách đơn nguồn mới (user thuộc memberships của tổ chức — kiểm ở use-case).
  owner_sale_id        String?
  /// Lead gốc khi đơn sinh từ lead (cổng nhận đơn `ingestOrder`).
  lead_id              String?
  lead                 leads?                    @relation("order_origin_lead", fields: [lead_id], references: [id], onDelete: SetNull)
  converted_leads      leads[]                   @relation("lead_converted_order")
  converted_quotations quotations[]              @relation("quotation_converted_order")
  /// `LEGACY` (kanban cũ, mặc định — mọi đơn hiện có) · `STANDARD` (quy trình chuẩn đa nguồn, P3).
  workflow             String                    @default("LEGACY")
  approval_requests    order_approval_requests[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_branch                               branches?                     @relation("fk_orders_branch_id", fields: [branch_id], references: [id], onDelete: SetNull)
  fk_voucher                              vouchers?                     @relation("fk_orders_voucher_id", fields: [voucher_id], references: [id], onDelete: SetNull)
  fk_source_session                       greeting_sessions?            @relation("fk_orders_source_session_id", fields: [source_session_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  vouchers_by_order_id                    vouchers[]                    @relation("fk_vouchers_order_id")
  greeting_payment_events_by_order_id     greeting_payment_events[]     @relation("fk_greeting_payment_events_order_id")
  staff_notifications_by_order_id         staff_notifications[]         @relation("fk_staff_notifications_order_id")
  greeting_messages_by_order_id           greeting_messages[]           @relation("fk_greeting_messages_order_id")
  greeting_catalog_events_by_order_id     greeting_catalog_events[]     @relation("fk_greeting_catalog_events_order_id")
  internal_chat_conversations_by_order_id internal_chat_conversations[] @relation("fk_internal_chat_conversations_order_id")
  sales_channel_orders_by_order_id        sales_channel_orders[]        @relation("fk_sales_channel_orders_order_id")
  voucher_redemptions_by_order_id         voucher_redemptions[]         @relation("fk_voucher_redemptions_order_id")
  greeting_notifications_by_order_id      greeting_notifications[]      @relation("fk_greeting_notifications_order_id")

  @@unique([organization_id, code])
  @@unique([id, organization_id]) // đích của khoá ghép tenant (05/11/2026)
  @@index([organization_id, status])
  @@index([organization_id, production_status])
  @@index([organization_id, source])
  @@index([organization_id, owner_sale_id])
  @@index([organization_id, lead_id])
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([customer_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([lead_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([source_session_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([voucher_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// ADR-014 D-P2, bước P-3a (PO duyệt 07/11/2026): người nhận và bên mua hoá đơn VAT của một đơn — nơi lưu dữ liệu cá
/// nhân của đơn (mã hoá ở P-5, xoá theo yêu cầu ở P-7). Giai đoạn ghi kép: `orders.delivery_address` (JSON) và các cột
/// `orders.vat_*` vẫn ghi và vẫn được đọc; đọc chuyển sang bảng này ở P-3b, bỏ nơi cũ ở P-3c. Ghi qua
/// `upsertOrderRecipient` (`src/modules/orders/infra/order-recipient-repository.ts`).
model order_recipients {
  organization_id         String
  order_id                String   @id // một dòng mỗi đơn
  /// @pii identity
  recipient_name          String?
  /// @pii contact
  recipient_phone         String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `recipient_phone` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii contact
  recipient_phone_enc     String?
  /// Dòng địa chỉ giao đầy đủ (như `formatDeliveryAddress`, null = chưa có / "Theo thỏa thuận").
  /// @pii address
  address_line            String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `address_line` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii address
  address_line_enc        String?
  /// 5 ô địa chỉ (`AddressParts`) hoặc phường/quận/tỉnh của đơn nhập phẳng.
  /// @pii address
  address_parts           Json?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `address_parts` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii address
  address_parts_enc       String?
  /// @pii tax
  vat_company_name        String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `vat_company_name` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii tax
  vat_company_name_enc    String?
  /// @pii tax
  vat_tax_code            String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `vat_tax_code` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii tax
  vat_tax_code_enc        String?
  /// @pii tax
  vat_company_address     String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `vat_company_address` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii tax
  vat_company_address_enc String?
  /// @pii tax
  vat_email               String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `vat_email` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii tax
  vat_email_enc           String?
  created_at              DateTime @default(now()) @db.Timestamptz(3)
  updated_at              DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([order_id, organization_id])
  @@index([organization_id])
}

/// ADR-014 D-P6, bước P-4 (PO duyệt 07/11/2026): quyền xem một đơn của bên nhận gia công — thay cho quyền ngầm của link
/// ký (hạn cố định, không thu hồi được). Một dòng mỗi (đơn, chi nhánh); đồng bộ theo phiên điều phối gia công trong
/// `SubcontractOrderRepository.updateSubcontractState`: được mời → `INVITED`, đang giữ/chốt đơn → `ASSIGNED`, còn lại
/// → thu hồi (`revoked_at`). `INVITED` hết khi đơn đóng; `ASSIGNED` hết 7 ngày sau khi đơn hoàn tất/huỷ (giao xong).
/// Thẻ Gia Công kiểm ở `loadSubcontractOrderForBranch`: không có quyền còn hiệu lực → 404.
model shared_order_access {
  id              String                    @id @default(uuid())
  /// Tổ chức chủ đơn
  organization_id String
  order_id        String
  /// Chi nhánh nhận gia công: `branches.id` hoặc mã điều phối, đúng như trong phiên điều phối và link ký
  branch_key      String
  level           shared_order_access_level
  granted_at      DateTime                  @default(now()) @db.Timestamptz(3)
  revoked_at      DateTime?                 @db.Timestamptz(3)
  updated_at      DateTime                  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([order_id, branch_key])
  @@index([organization_id, branch_key])
}

/// ADR-014 D-P3, bước P-5a (PO duyệt 07/11/2026): khoá dữ liệu mã hoá cột cá nhân của một tổ chức, đã bọc bằng khoá chủ
/// `PII_ENCRYPTION_KEY` (biến môi trường, không ở CSDL). Xoá khoá của tổ chức = dữ liệu cá nhân của tổ chức không giải
/// được nữa. `version` ghi trong từng bản mã để xoay khoá theo lô.
model tenant_data_keys {
  id              String    @id @default(uuid())
  organization_id String
  version         Int
  /// Khoá 32 byte bọc AES-256-GCM bằng khoá chủ (`v1.<iv>.<tag>.<ct>`)
  wrapped_key     String
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  retired_at      DateTime? @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, version])
  @@index([organization_id])
}

enum shared_order_access_level {
  INVITED
  ASSIGNED
}

model order_items {
  id              String  @id @default(uuid())
  organization_id String
  order_id        String
  product_id      String?
  variant_id      String?
  description     String? // khi khách đặt mẫu ngoài danh mục
  quantity        Int     @default(1)
  unit_price_vnd  Decimal @db.Decimal(14, 2)
  metadata        Json? // BOM có cấu trúc (FlowerBomItem[]), wrapStyle/ribbon, ảnh mẫu — từ Product Master Index lúc chọn mẫu, để phiếu cắm hoa (florist ticket) không phải bịa dữ liệu

  created_at   DateTime      @default(now()) @db.Timestamptz(3)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  order        orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products?         @relation("fk_order_items_product_id", fields: [product_id], references: [id], onDelete: SetNull)
  fk_variant product_variants? @relation("fk_order_items_variant_id", fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([organization_id, order_id])
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([variant_id]) // khoá ngoại cần index (ADR-015 O-1)
}

model order_assignments {
  id              String    @id @default(uuid())
  organization_id String
  order_id        String
  assignee_id     String // thành viên nhận việc cắm
  assigned_by     String
  difficulty      String? // định mức tiền công theo độ khó
  assigned_at     DateTime  @default(now()) @db.Timestamptz(3)
  released_at     DateTime? @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, assignee_id])
  @@index([organization_id, order_id])
}

model order_events {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String
  axis            String // order · production · delivery
  from_value      String?
  to_value        String
  actor_id        String?
  reason          String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, order_id, created_at])
}

// ── M09 — CRM & Khách hàng ngành hoa (P21) ──────────────────────────────────

enum customer_status {
  ACTIVE
  PROSPECT
}

enum customer_tier {
  NEW
  BRONZE
  SILVER
  GOLD
  VIP
}

enum consent_channel {
  ZALO_ZNS
  SMS
  PHONE_CALL
  PROMOTION
}

enum voucher_discount_type {
  PERCENTAGE
  FIXED_AMOUNT
}

model customers {
  id                String          @id @default(uuid())
  organization_id   String
  code              String // KH-0001, KH-0002
  /// @pii identity
  name              String
  /// @pii contact
  phone             String
  /// ADR-014 P-5a: bản mã AES-256-GCM của `phone` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii contact
  phone_enc         String?
  /// P-5a: HMAC-SHA256 của số đã chuẩn hoá (khoá riêng của tổ chức) — khớp đúng số, thay tìm theo chuỗi rõ
  /// @pii contact
  phone_hash        String?
  /// P-5a: 4 số cuối dạng rõ — ô tìm kiếm (PO D-49)
  /// @pii contact
  phone_last4       String?
  /// @pii contact
  email             String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `email` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii contact
  email_enc         String?
  /// @pii address
  address           String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `address` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii address
  address_enc       String?
  tier              customer_tier   @default(NEW)
  /// ADR-014 D-P2, P-2 (PO 07/11/2026): PROSPECT = người nhận link Thẻ chào có SĐT mà chưa đặt đơn — không hiện ở
  /// danh sách khách, xuất, phân khúc; đặt đơn, để lại lead hay được tạo tay thì thành ACTIVE.
  status            customer_status @default(ACTIVE)
  /// Chi nhánh của khách (D-58, ADR-012 T-5): chi nhánh của người tạo hoặc của đơn đầu tiên có chi nhánh; null = khách
  /// dùng chung toàn tổ chức. Tổ chức bật `settings.branch_scope.wave1` thì nhân viên chi nhánh chỉ thấy khách của
  /// chi nhánh mình và khách dùng chung.
  branch_id         String?
  notes             String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `notes` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii free_text
  notes_enc         String?
  tags              String[]        @default([])
  preferred_flowers String[]        @default([])
  preferred_colors  String[]        @default([])

  total_spent   Decimal   @default(0) @db.Decimal(14, 2)
  order_count   Int       @default(0)
  last_order_at DateTime? @db.Timestamptz(3)

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  organization      organizations           @relation(fields: [organization_id], references: [id])
  fk_branch         branches?               @relation("fk_customers_branch_id", fields: [branch_id], references: [id], onDelete: SetNull)
  orders            orders[]
  occasions         customer_occasions[]
  consents          customer_consents[]
  vouchers          vouchers[]
  conversations     chat_conversations[]
  leads             leads[]
  quotations        quotations[]
  interactions      customer_interactions[]
  greeting_sessions greeting_sessions[]

  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  voucher_redemptions_by_customer_id voucher_redemptions[] @relation("fk_voucher_redemptions_customer_id")

  @@unique([organization_id, phone])
  @@unique([organization_id, code])
  @@unique([id, organization_id]) // đích của khoá ghép tenant (05/11/2026)
  @@index([organization_id, tier])
  @@index([organization_id, name])
  @@index([organization_id, status])
  @@index([organization_id, branch_id])
  @@index([branch_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([organization_id, phone_hash]) // P-5a: khớp đúng số (P-5c thay ràng buộc duy nhất theo `phone`)
  @@index([organization_id, phone_last4])
}

model customer_occasions {
  id                   String   @id @default(uuid())
  organization_id      String
  customer_id          String
  name                 String // Sinh nhật vợ, Kỷ niệm ngày cưới, Ngày của Mẹ...
  date                 String // MM-DD hoặc YYYY-MM-DD
  is_recurring         Boolean  @default(true)
  reminder_days_before Int      @default(7)
  /// @pii identity
  recipient_name       String?
  notes                String?
  created_at           DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  customer     customers     @relation(fields: [customer_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, customer_id])
  @@index([organization_id, date])
}

model customer_consents {
  id              String          @id @default(uuid())
  organization_id String
  customer_id     String
  channel         consent_channel
  granted         Boolean         @default(true)
  granted_at      DateTime        @default(now()) @db.Timestamptz(3)
  revoked_at      DateTime?       @db.Timestamptz(3)
  created_at      DateTime        @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  customer     customers     @relation(fields: [customer_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([customer_id, channel])
  @@index([organization_id, customer_id])
}

model vouchers {
  id                 String                @id @default(uuid())
  organization_id    String
  customer_id        String? // null nếu áp dụng công khai
  code               String // FLORA10, VIP2026
  discount_type      voucher_discount_type @default(PERCENTAGE)
  discount_value     Decimal               @db.Decimal(14, 2)
  min_order_vnd      Decimal               @default(0) @db.Decimal(14, 2)
  max_discount_vnd   Decimal?              @db.Decimal(14, 2)
  expires_at         DateTime?             @db.Timestamptz(3)
  is_used            Boolean               @default(false)
  used_at            DateTime?             @db.Timestamptz(3)
  order_id           String?
  created_at         DateTime              @default(now()) @db.Timestamptz(3)
  /// Phát hành mã giảm giá (PO 30/10/2026): mã thuộc một đợt phát hành; null = mã lẻ cũ.
  batch_id           String?
  /// Ưu đãi trong danh mục `store_policies` mà mã thuộc về — tắt/khoá ưu đãi là mã ngừng nhận.
  promotion_id       String?
  starts_at          DateTime?             @db.Timestamptz(3)
  /// Tổng lượt dùng tối đa; null = không giới hạn. Mã cũ = 1 lượt.
  usage_limit        Int?                  @default(1)
  /// Lượt tối đa cho mỗi khách; null = không giới hạn.
  per_customer_limit Int?
  used_count         Int                   @default(0)
  is_active          Boolean               @default(true)

  updated_at   DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations         @relation(fields: [organization_id], references: [id])
  customer     customers?            @relation(fields: [customer_id], references: [id])
  batch        voucher_batches?      @relation(fields: [batch_id], references: [id])
  redemptions  voucher_redemptions[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order             orders?  @relation("fk_vouchers_order_id", fields: [order_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  orders_by_voucher_id orders[] @relation("fk_orders_voucher_id")

  @@unique([organization_id, code])
  @@index([organization_id, customer_id])
  @@index([organization_id, batch_id])
  @@index([batch_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([customer_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Một đợt phát hành mã giảm giá — cùng điều kiện cho mọi mã trong đợt.
model voucher_batches {
  id                 String                @id @default(uuid())
  organization_id    String
  name               String
  promotion_id       String?
  code_prefix        String?
  quantity           Int
  discount_type      voucher_discount_type
  discount_value     Decimal               @db.Decimal(14, 2)
  min_order_vnd      Decimal               @default(0) @db.Decimal(14, 2)
  max_discount_vnd   Decimal?              @db.Decimal(14, 2)
  starts_at          DateTime?             @db.Timestamptz(3)
  expires_at         DateTime?             @db.Timestamptz(3)
  usage_limit        Int?
  per_customer_limit Int?
  is_active          Boolean               @default(true)
  created_by         String
  created_at         DateTime              @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  vouchers     vouchers[]

  @@index([organization_id])
}

/// Mỗi lần một mã được dùng cho một đơn — để đếm lượt theo khách và trả lượt khi huỷ đơn.
model voucher_redemptions {
  id              String    @id @default(uuid())
  organization_id String
  voucher_id      String
  order_id        String
  customer_id     String?
  redeemed_at     DateTime  @default(now()) @db.Timestamptz(3)
  released_at     DateTime? @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id])
  voucher      vouchers      @relation(fields: [voucher_id], references: [id])

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order    orders     @relation("fk_voucher_redemptions_order_id", fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  fk_customer customers? @relation("fk_voucher_redemptions_customer_id", fields: [customer_id], references: [id], onDelete: SetNull)

  @@unique([voucher_id, order_id])
  @@index([organization_id])
  @@index([organization_id, order_id])
  @@index([customer_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ── M08 — AI Chat Assistant & Hội thoại (P23) ──────────────────────────────

enum chat_channel {
  WEB_WIDGET
  INTERNAL_DASHBOARD
  STOREFRONT_CATALOG
  LANDING_PAGE
  FACEBOOK_MESSENGER
  ZALO_OA
  EMBEDDED_WIDGET
  ZALO
}

enum chat_sender_type {
  USER
  ASSISTANT
  SYSTEM
}

model chat_conversations {
  id              String       @id @default(uuid())
  organization_id String
  customer_id     String?
  title           String       @default("Hội thoại tư vấn hoa")
  channel         chat_channel @default(WEB_WIDGET)
  status          String       @default("ACTIVE") // ACTIVE, CLOSED
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @updatedAt @db.Timestamptz(3)

  organization organizations   @relation(fields: [organization_id], references: [id])
  customer     customers?      @relation(fields: [customer_id], references: [id])
  messages     chat_messages[]

  @@index([organization_id, status])
  @@index([organization_id, customer_id])
  @@index([customer_id]) // khoá ngoại cần index (ADR-015 O-1)
}

model chat_messages {
  id              String           @id @default(uuid())
  organization_id String
  conversation_id String
  sender_type     chat_sender_type
  content         String
  metadata        Json? // Gợi ý hoa từ Master Index, Draft Order ID

  created_at DateTime @default(now()) @db.Timestamptz(3)

  organization organizations      @relation(fields: [organization_id], references: [id])
  conversation chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([organization_id, conversation_id, created_at])
  @@index([conversation_id]) // khoá ngoại cần index (ADR-015 O-1)
}

model chat_channel_integrations {
  id                      String       @id @default(uuid())
  organization_id         String
  channel                 chat_channel
  is_enabled              Boolean      @default(false)
  config                  Json         @default("{}")
  subscription_expires_at DateTime?    @db.Timestamptz(3)
  created_at              DateTime     @default(now()) @db.Timestamptz(3)
  updated_at              DateTime     @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, channel])
  @@index([organization_id, is_enabled])
}

// ── Danh mục loài hoa ───────────────────────────────────────────────────────
// NGOẠI LỆ DUY NHẤT của Luật 1 (mọi bảng thuộc tenant mang organization_id):
// đây là tri thức ngành, không phải dữ liệu của một cửa hàng. Hồng vẫn là
// hồng ở mọi tổ chức. Đặt `organization_id` vào đây sẽ buộc mỗi tổ chức mới
// phải chép lại 86 loài, và hai tổ chức sẽ dần gọi cùng một loài bằng hai mã.
//
// Nguồn: `workers/vision/contracts/species_catalog.json`, trích từ sổ vận
// hành thật của AVI GIFT. Từ tệp JSON đọc-một-chiều thành bảng: cần thế để
// người vận hành sửa được tên và dấu hiệu phân biệt mà không phải sửa mã, và
// để bước soát tên loài tra được bằng truy vấn thay vì nạp cả tệp vào bộ nhớ.

model flower_taxonomy {
  ma_loai              String  @id // LH001…
  nhom                 String // Hoa · Lá · Phụ kiện
  cong_nang            String? // Hoa chính · Hoa phụ · Hoa lấp đầy…
  ten_chuan            String
  ten_khac             Json // string[] — tên gọi khác, dùng để so tên máy trả về
  nhom_hoa             String?
  dvt_chuan            String?
  so_bong_tren_dvt     Int?
  duong_kinh_bong_cm   Float?
  dien_tich_phu_cm2    Float?
  ty_le_nhuy_tren_bong Float?
  mau_nhuy             String?
  kieu_moc             String?
  dai_mau_tu_nhien     Json? // string[]
  dac_diem_phan_biet   String?
  mua_vu               String?
  trang_thai           String  @default("Đang dùng")

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  cap_a flower_confusable_pairs[] @relation("loai_a")
  cap_b flower_confusable_pairs[] @relation("loai_b")

  @@index([ten_chuan])
  @@index([nhom])
}

// 63 cặp dễ nhầm. Đây là chỗ bắt LỖI HỆ THỐNG của bước nhận diện — dạng lỗi
// mà gọi lại mô hình ba lượt vẫn ra cùng một câu trả lời sai, nên cơ chế
// đồng thuận không thấy. Máy trả về một loài nằm trong một cặp `Cao` thì
// giao diện phải bày dấu hiệu tách của cả hai cho người soát nhìn, chứ không
// im lặng nhận lấy tên máy đưa.
model flower_confusable_pairs {
  ma_cap          String @id // CN001…
  ma_loai_a       String
  ma_loai_b       String
  dau_hieu_tach_a String
  dau_hieu_tach_b String
  muc_do_nham     String // Cao · Trung bình · Thấp

  created_at DateTime        @default(now()) @db.Timestamptz(3)
  loai_a     flower_taxonomy @relation("loai_a", fields: [ma_loai_a], references: [ma_loai])
  loai_b     flower_taxonomy @relation("loai_b", fields: [ma_loai_b], references: [ma_loai])

  @@index([ma_loai_a])
  @@index([ma_loai_b])
  @@index([muc_do_nham])
}

// ─────────────────────────────────────────────────────────────────────────
// Console Vận hành Nền tảng (P25, chốt 18-19/09/2026) — ba bảng KHÔNG mang
// `organization_id`, ngoại lệ có chủ đích của Luật 1 (đặc tả 07 mục 1),
// cùng hạng với `ai_capabilities`/`ai_models`. Xem
// docs/kien-truc/KE_HOACH_CONSOLE_VAN_HANH.md mục 4.1 và D-N6 (tách hẳn từ
// vựng năng lực nền tảng khỏi `roles`/`role_capabilities` của tenant —
// KHÔNG dùng `capability_scope`, không thêm giá trị PLATFORM vào enum đó).
// `tests/helpers/database.ts` KHÔNG truncate ba bảng này, giống ai_models.

/// Người được cấp quyền vận hành nền tảng — độc lập hoàn toàn với
/// `memberships`. Một user có thể vừa là thành viên một tổ chức (qua
/// memberships) vừa là người vận hành nền tảng (qua bảng này) — hai bảng
/// không loại trừ nhau. Gán lần đầu bằng script chạy tay
/// `scripts/gan-van-hanh-nen-tang.ts` (D-N2) — không có UI tự gán.
model platform_operators {
  id         String    @id @default(uuid())
  user_id    String    @unique
  granted_by String? // user_id của người gán, null nếu tự gán qua script lần đầu
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  revoked_at DateTime? @db.Timestamptz(3)

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  capabilities platform_role_capabilities[]

  @@index([user_id])
}

/// Mã năng lực nền tảng (`N1`…`N8`, `src/core/platform/platform-capability-catalog.ts`)
/// cấp cho một người vận hành. TÁCH HẲN khỏi `role_capabilities` của
/// tenant (D-N6) — không có "vai" ở đây, mỗi người vận hành có tập mã
/// riêng, gán thẳng.
model platform_role_capabilities {
  id              String @id @default(uuid())
  operator_id     String
  capability_code String // N1 … N8

  created_at DateTime           @default(now()) @db.Timestamptz(3)
  updated_at DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  operator   platform_operators @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@unique([operator_id, capability_code])
}

/// Bí mật cấp NỀN TẢNG (không thuộc tổ chức nào), niêm phong bằng secret-box.
/// Dùng cho mã truy cập + refresh token của Zalo OA chung: refresh token chỉ dùng một lần,
/// nên mỗi lần làm mới phải khoá dòng và lưu cặp mới. Không bao giờ trả ra API hay log.
model platform_secrets {
  key          String   @id // vd. zalo_oa_tokens
  sealed_value String
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
}

/// Nhật ký cho hành động KHÔNG thuộc một tổ chức cụ thể (xem sức khoẻ hệ
/// thống, gán/thu vai vận hành). Hành động chạm MỘT tổ chức cụ thể (nạp
/// credit, duyệt nâng cấp) vẫn ghi vào `audit_logs` hiện có với
/// `organization_id` của tổ chức đó — bảng này không thay thế `audit_logs`.
/// Tách riêng vì `audit_logs.organization_id` là `NOT NULL` (D-N3).
/// Nhân viên nền tảng truy cập dữ liệu của một tổ chức (ADR-013 D-I5, D-60): mỗi yêu cầu Console vào
/// `platform/organizations/:id/*` hoặc `platform/orgs-data/:orgId/*` ghi một dòng, TRƯỚC khi trả dữ liệu. Thuộc tổ chức:
/// chủ tổ chức xem ở `/audit` (tab "Truy cập của nền tảng", quyền G9). Chỉ thêm dòng (trigger `smeos_append_only_guard`).
model platform_access_logs {
  id              String   @id @default(uuid())
  organization_id String
  /// `users.id` của người vận hành nền tảng
  operator_id     String
  /// Mã mục đích suy từ thao tác (`describePlatformAccess`), vd. `org.profile.read`, `org.records.orders.export`
  purpose         String
  method          String
  /// Đường dẫn API (không kèm query)
  route           String
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id, created_at])
}

model platform_audit_logs {
  id          String   @id @default(uuid())
  user_id     String
  action      String // platform.health.read · platform.operator.grant …
  entity_type String
  entity_id   String
  before      Json?
  after       Json?
  ip          String?
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([created_at])
  @@index([entity_type, entity_id])
}

/// Cấu hình cấp nền tảng — một dòng mỗi khoá, chỉ Console vận hành ghi. Không thuộc tổ chức nào
/// nên không có `organization_id` (đặc tả 07 mục 1, cùng hạng `platform_operators`).
/// Khoá đang dùng: `nav_matrix_overrides` — ma trận điều hướng theo ngành (rà soát M13, 22/10/2026).
model platform_settings {
  key        String   @id
  value      Json
  updated_by String?
  updated_at DateTime @updatedAt @db.Timestamptz(3)
  created_at DateTime @default(now()) @db.Timestamptz(3)
}

// ─────────────────────────────────────────────────────────────────────────
// Nền quản trị trường (ĐP-3, 26/09/2026) — quản trị nền tảng sửa được mọi
// trường đã xây, mọi danh mục, và tạo được trường HOÀN TOÀN MỚI, không cần
// sửa mã. Xem docs/kien-truc/KE_HOACH_DIEU_PHOI_TRUONG_DU_LIEU.md mục 6.
//
// `field_definitions` / `field_catalogs` / `field_catalog_values` là NGOẠI
// LỆ CÓ CHỦ ĐÍCH của Luật 1 (không `organization_id`) — cùng hạng với
// `platform_operators`/`ai_models`: đây là sổ đăng ký của toàn hệ thống,
// không phải dữ liệu thử của một tổ chức. `field_config_overrides` NGƯỢC
// LẠI có `organization_id` — nó là ghi đè THEO TỪNG tổ chức, dù chỉ quản
// trị nền tảng (N12) mới được ghi vào đó; nằm trong TENANT_TABLES.

enum field_origin {
  CORE
  CUSTOM
}

enum field_requirement_level {
  OPTIONAL
  RECOMMENDED
  REQUIRED
}

enum field_sensitivity {
  NORMAL
  PII
  SENSITIVE
}

enum field_status {
  ACTIVE
  INACTIVE
}

enum field_catalog_governance {
  OPEN
  BEHAVIOR
  CLOSED
}

enum field_override_target {
  FIELD
  CATALOG_VALUE
}

/// Một dòng cho MỖI trường — cả trường lõi (`origin = CORE`, khai bằng mã ở
/// `src/modules/field-platform/domain/core-field-registry.ts`, nạp vào đây
/// bằng seed 3.6) và trường tự tạo (`origin = CUSTOM`, tạo thẳng từ Console
/// theo 3.7). `key` không đổi sau khi tạo (luật 3.4).
model field_definitions {
  id                    String                  @id @default(uuid())
  key                   String                  @unique
  entity                String // ORDER · PARTNER (ĐP-4 mở thêm QC_RECORD/EXCEPTION/PAYMENT)
  origin                field_origin            @default(CORE)
  data_type             String
  label                 String
  description           String?
  placeholder           String?
  /// { placements: [{ placement: "T01.delivery", order: 3 }, …] }
  placements            Json?
  requirement           field_requirement_level @default(OPTIONAL)
  required_at_stage     String?
  /// { INTERNAL: true, PARTNER: false, SHIPPER: false, CUSTOMER: false }
  visibility            Json?
  /// Ràng buộc bổ sung ngoài `data_type` (độ dài, min/max, regex…).
  validation            Json?
  catalog_key           String?
  sensitivity           field_sensitivity       @default(NORMAL)
  /// Mức sàn §16.2 mục 1: true thì KHÔNG tổ chức nào, cấu hình nào mở được
  /// hiển thị ra ngoài INTERNAL (giá bán, giá vốn…). Đọc CÙNG với
  /// `sensitivity` ở `field-rules.ts` — hai cờ độc lập, cùng mục đích khoá sàn.
  floor_internal_only   Boolean                 @default(false)
  status                field_status            @default(ACTIVE)
  /// Trường tự tạo mặc định áp cho tổ chức nào: true = mọi tổ chức trừ khi
  /// bị tắt qua `field_config_overrides`; false = "trường tự tạo chỉ áp
  /// cho tổ chức này" — cần override `is_enabled = true` mới thấy (6.1).
  default_enabled       Boolean                 @default(true)
  /// Checklist ALG 1.9: null = trường của nền tảng (lõi hoặc quản trị nền tảng
  /// tạo); có giá trị = trường cửa hàng tự tạo, chỉ tổ chức đó thấy và ghi.
  owner_organization_id String?
  created_by            String?
  updated_by            String?
  created_at            DateTime                @default(now()) @db.Timestamptz(3)
  updated_at            DateTime                @updatedAt @db.Timestamptz(3)

  owner_organization organizations? @relation("field_definition_owner", fields: [owner_organization_id], references: [id], onDelete: Cascade)

  @@index([entity])
  @@index([catalog_key])
  @@index([owner_organization_id])
}

/// Một danh mục (ví dụ `order_priority`, `service_level`…). `governance`
/// quyết định quản trị nền tảng được làm gì với các giá trị bên trong:
/// `OPEN` — thêm/sửa/tắt tự do; `BEHAVIOR` — giá trị gắn `behavior` (mã
/// hành vi có thật trong code, 3.3), chỉ chỉnh `params`, không đổi
/// `behavior`; `CLOSED` — chỉ bật/tắt, không thêm/sửa (vd. trạng thái nội
/// bộ do luật nghiệp vụ cố định số lượng).
model field_catalogs {
  id            String                   @id @default(uuid())
  key           String                   @unique
  label         String
  governance    field_catalog_governance @default(OPEN)
  behavior_kind String?
  created_at    DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at    DateTime                 @updatedAt @db.Timestamptz(3)

  values field_catalog_values[]
}

model field_catalog_values {
  id          String   @id @default(uuid())
  catalog_key String
  code        String
  label       String
  description String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  /// Mã hành vi có thật trong `field-platform/domain/behaviors.ts` khi
  /// `catalog.governance = BEHAVIOR`. Null cho danh mục `OPEN`/`CLOSED`.
  behavior    String?
  params      Json?
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  catalog field_catalogs @relation(fields: [catalog_key], references: [key], onDelete: Cascade)

  @@unique([catalog_key, code])
  @@index([catalog_key])
}

/// Ghi đè THEO TỔ CHỨC — chỉ quản trị nền tảng (N12) ghi. `target = FIELD`
/// dùng `override_key = field_definitions.key`; `target = CATALOG_VALUE`
/// dùng `override_key = "<catalog_key>:<code>"`. Mức sàn (luật 3.4) cắt sau
/// cùng, không đọc thẳng từ đây — không route nào được phép bỏ qua lớp mã.
model field_config_overrides {
  id              String                   @id @default(uuid())
  organization_id String
  target          field_override_target
  override_key    String
  label           String?
  visibility      Json?
  requirement     field_requirement_level?
  is_enabled      Boolean?
  created_by      String?
  updated_by      String?
  created_at      DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at      DateTime                 @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, target, override_key])
  @@index([organization_id])
}

// ─────────────────────────────────────────────────────────────────────────
// Phân hệ Nghiên cứu Thị trường & Xu hướng (Market Intelligence Engine) — Đợt A
// 8 bảng nghiên cứu dữ liệu thị trường là GLOBAL (ngoại lệ Luật 1 khai báo ở
// đặc tả 07 mục 1 & 16), 1 bảng content_opportunities thuộc TENANT.

enum market_source_status {
  ACTIVE
  DEGRADED
  DISABLED
}

enum trend_topic_status {
  EMERGING
  RISING
  STABLE
  DECLINING
  SEASONAL
  BREAKOUT
}

enum research_run_type {
  DAILY_DEEP
  INTRADAY_PULSE
  WEEKLY_DEEP
  MANUAL
}

enum research_run_status {
  PENDING
  RUNNING
  PARTIAL_SUCCESS
  COMPLETED
  FAILED
}

enum provider_health_status {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

/// Nguồn thu thập dữ liệu xu hướng thị trường (Google Trends, SerpApi, v.v.)
model market_sources {
  id              String               @id @default(uuid())
  provider        String
  platform        String
  source_type     String
  status          market_source_status @default(ACTIVE)
  last_success_at DateTime?            @db.Timestamptz(3)
  last_error_at   DateTime?            @db.Timestamptz(3)
  created_at      DateTime             @default(now()) @db.Timestamptz(3)
  updated_at      DateTime             @updatedAt @db.Timestamptz(3)

  trend_signals trend_signals[]
  topic_signals topic_signals[]

  @@unique([provider, platform])
}

/// Tín hiệu xu hướng thu thập được từ các nguồn
model trend_signals {
  id           String   @id @default(uuid())
  source_id    String
  platform     String
  country_code String   @default("VN")
  region_code  String?
  city         String?
  industry     String   @default("florist")
  topic_raw    String
  metric_name  String
  metric_value Float
  growth_rate  Float?
  confidence   Float    @default(1.0)
  captured_at  DateTime @default(now()) @db.Timestamptz(3)
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  source market_sources @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([source_id, platform, country_code, topic_raw, captured_at])
  @@index([source_id])
  @@index([platform, country_code])
  @@index([captured_at])
  @@index([industry])
}

/// Chuỗi thời gian của chủ đề xu hướng
model trend_timeseries {
  id           String   @id @default(uuid())
  topic_id     String
  platform     String
  geo_scope    String   @default("VN")
  date         DateTime @db.Timestamptz(3)
  value        Float
  growth_rate  Float?
  velocity     Float?
  acceleration Float?
  confidence   Float    @default(1.0)

  topic topics @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([topic_id, platform, geo_scope, date])
  @@index([topic_id])
  @@index([date])
}

/// Chủ đề xu hướng được chuẩn hóa (canonical topics)
model topics {
  id             String             @id @default(uuid())
  canonical_name String
  description    String?
  language       String             @default("vi")
  industry       String             @default("florist")
  status         trend_topic_status @default(EMERGING)
  first_seen_at  DateTime           @default(now()) @db.Timestamptz(3)
  last_seen_at   DateTime           @default(now()) @db.Timestamptz(3)

  timeseries            trend_timeseries[]
  signals               topic_signals[]
  scores                topic_scores[]
  content_opportunities content_opportunities[]

  @@unique([canonical_name, industry])
  @@index([status])
  @@index([industry])
  @@index([last_seen_at])
}

/// Nối giữa chủ đề và nguồn tín hiệu gốc
model topic_signals {
  id                 String   @id @default(uuid())
  topic_id           String
  source_id          String
  external_reference String?
  signal_type        String
  signal_value       Float
  captured_at        DateTime @default(now()) @db.Timestamptz(3)

  topic  topics         @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  source market_sources @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@index([topic_id])
  @@index([source_id])
}

/// Điểm số tổng hợp của chủ đề xu hướng
model topic_scores {
  id                        String   @id @default(uuid())
  topic_id                  String
  geo_scope                 String   @default("VN")
  industry                  String   @default("florist")
  period                    String   @default("7d")
  trend_score               Float
  viral_score               Float
  commercial_score          Float
  content_opportunity_score Float
  confidence                Float    @default(1.0)
  calculated_at             DateTime @default(now()) @db.Timestamptz(3)
  model_version             String   @default("v1_florist")

  topic topics @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([topic_id])
  @@index([period])
  @@index([content_opportunity_score])
}

/// Gợi ý cơ hội nội dung được cá nhân hóa cho từng tổ chức (TENANT)
model content_opportunities {
  id                        String    @id @default(uuid())
  organization_id           String
  topic_id                  String
  audience                  String?
  opportunity_summary       String
  content_angles            Json
  recommended_formats       Json
  recommended_hooks         Json
  trend_score               Float
  viral_score               Float
  commercial_score          Float
  content_opportunity_score Float
  confidence                Float     @default(1.0)
  expires_at                DateTime? @db.Timestamptz(3)
  created_at                DateTime  @default(now()) @db.Timestamptz(3)
  updated_at                DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  topic        topics        @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([organization_id, content_opportunity_score])
  @@index([organization_id])
  @@index([topic_id])
}

/// Lưu lại từng lượt phân tích Product Intelligence (Quét theo ảnh sản phẩm) — TENANT.
/// Nợ kỹ thuật #113 (đã trả 21/09/2026): trước đây route chạy xong là mất, không có lịch sử.
/// `report` lưu nguyên vẹn toàn bộ ProductIntelligenceReport dạng JSONB (đúng khuyến nghị
/// "Use JSONB for flexible AI output" ở mục 35 đặc tả v2.0) — các trường điểm số tách cột
/// riêng để lọc/sắp xếp nhanh mà không phải parse JSON.
///
/// Nợ #118 (chốt 22/09/2026, trả cùng lượt sửa Chặng 05 CHOOSE gãy):
/// `asset_id` chuyển BẮT BUỘC (trước đó `String?`) — không còn nhận lượt
/// phân tích nào không neo vào một asset thật. `image_url` BỎ HẲN cột này —
/// nó từng lưu thẳng Data URL base64 của client (770KB–1MB/dòng, xác minh
/// trên Postgres dev thật 22/09/2026), trùng lặp với chính asset đã có ở
/// bảng `assets`. Ảnh hiển thị từ nay LUÔN ký lại tại thời điểm đọc qua
/// `GET /api/v1/assets/:id/view-url`, không lưu URL/base64 ở bất kỳ đâu.
/// `report` JSONB cũng không còn mang `imageUrl` thật (rỗng hoá trước khi
/// ghi) — xem `analyze-product-intelligence.ts`.
model product_analysis_runs {
  id                 String   @id @default(uuid())
  organization_id    String
  asset_id           String
  product_name       String
  trend_fit_score    Float
  audience_fit_score Float
  content_fit_score  Float
  overall_fit        String
  report             Json
  created_at         DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, created_at])
}

/// Lượt chạy nghiên cứu thị trường — kiêm hàng đợi job cho worker
model research_runs {
  id                    String              @id @default(uuid())
  run_type              research_run_type   @default(DAILY_DEEP)
  status                research_run_status @default(PENDING)
  started_at            DateTime?           @db.Timestamptz(3)
  completed_at          DateTime?           @db.Timestamptz(3)
  sources_attempted     Int                 @default(0)
  sources_succeeded     Int                 @default(0)
  sources_failed        Int                 @default(0)
  records_collected     Int                 @default(0)
  topics_created        Int                 @default(0)
  opportunities_created Int                 @default(0)
  error_summary         String?
  created_at            DateTime            @default(now()) @db.Timestamptz(3)

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status, created_at])
}

/// Bảng theo dõi sức khỏe và chất lượng của các nhà cung cấp dữ liệu xu hướng
model provider_health {
  id              String                 @id @default(uuid())
  provider        String                 @unique
  status          provider_health_status @default(HEALTHY)
  latency_ms      Int?
  error_rate      Float?
  quota_status    String?
  last_checked_at DateTime               @default(now()) @db.Timestamptz(3)

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status])
}

/// Gói chiến dịch của Creative Studio (Khu vực F, Chặng 07–14) — TENANT.
/// 23/09/2026: trước ngày này Chặng 07–09 chỉ là state phía trình duyệt (QA
/// luôn "PASSED", duyệt không ghi gì) và Chặng 10–14 hiển thị số liệu gõ cứng.
/// Gói chỉ giữ ĐỊNH DANH tới tài sản thật (asset biến thể, video job, audio job)
/// + nội dung bài đăng do người dùng soạn; QA chạy phía máy chủ trên dữ liệu thật
/// (`campaign-package-rules.ts`), duyệt ghi `audit_logs` cùng giao dịch.
model campaign_packages {
  id                String    @id @default(uuid())
  organization_id   String
  product_id        String?
  master_asset_id   String
  name              String
  mode              String // CREATIVE | AUTHENTIC
  /// Ảnh chụp chủ đề đã chọn ở Chặng 05 (id, title, angleCategory, hook, cta).
  topic             Json?
  /// Nội dung bài đăng theo kênh: [{ channel, text, hashtags[] }].
  content           Json?
  variant_asset_ids String[]  @default([])
  /// Video chính (= phần tử đầu của `video_job_ids`, giữ để tương thích).
  video_job_id      String?
  /// Mọi video của gói — mỗi khung hình trong phạm vi sản xuất một video (24/09/2026).
  video_job_ids     String[]  @default([])
  audio_job_id      String?
  /// DRAFT | QA_PASSED | QA_NEEDS_REVIEW | QA_REJECTED | APPROVED
  status            String    @default("DRAFT")
  qa_report         Json?
  qa_checked_at     DateTime? @db.Timestamptz(3)
  approved_by       String?
  approved_at       DateTime? @db.Timestamptz(3)
  /// Kế hoạch đăng (Chặng 10): { channels[], scheduled_at, post_refs[{platform, content_id}] }.
  launch_plan       Json?
  created_by        String
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  updated_at        DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products? @relation("fk_campaign_packages_product_id", fields: [product_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([organization_id, master_asset_id])
  @@index([organization_id, status])
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Bài đăng Khu vực B (Chặng 06a) TỰ LƯU theo ảnh + chủ đề + mode (24/09/2026) —
/// để Chặng 07 đưa sẵn vào gói chiến dịch mà người dùng không phải bấm lưu.
/// TENANT: `organization_id` bắt buộc, mọi truy vấn qua `scopedWhere`/`scopedData`.
model content_drafts {
  id              String   @id @default(uuid())
  organization_id String
  /// Ảnh sản phẩm Khu vực A (`assets.id`) — cùng khoá với kịch bản bối cảnh.
  asset_id        String
  topic_id        String
  mode            String // CREATIVE | AUTHENTIC
  topic_title     String?
  /// [{ channel, text, hashtags[] }] — cùng hình dạng `campaign_packages.content`.
  posts           Json
  created_by      String
  updated_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, asset_id, topic_id, mode])
  @@index([organization_id, updated_at])
}

/// Kết quả Content Engine (P27, quyết định PO 25/09/2026). TENANT. Một bản ghi
/// mỗi lượt viết bài của chuỗi agent Strategist→Writer→Critic→Rewriter (Đợt 2)
/// — brief chụp sẵn tại thời điểm chạy, phiên bản prompt/rubric, bài theo từng
/// kênh kèm điểm, để tái hiện/so sánh và nâng cấp đo được (mục 5 kế hoạch).
model content_generations {
  id              String  @id @default(uuid())
  organization_id String
  job_id          String?
  /// creative_studio | content_engine_ui | package_rewrite
  origin          String
  asset_id        String?
  product_id      String?
  topic_id        String?
  scene_plan_id   String?
  /// AUTHENTIC | CREATIVE — vắng khi không gắn với kịch bản Chặng 05
  mode            String?

  /// Kênh đã chạy — facebook | instagram | tiktok | zalo
  channels        Json
  /// Bản chụp Content Brief v1 tại thời điểm chạy (`contracts/brief.ts`).
  brief           Json
  /// Trùng `contracts/brief.ts#BRIEF_VERSION` tại thời điểm chạy.
  brief_version   Int
  /// { strategist, writer, critic, rewriter } — mã phiên bản prompt mỗi bước.
  prompt_versions Json
  rubric_version  String

  /// Kết quả Strategist — thông điệp chính + góc/hook/dàn ý mỗi kênh.
  strategy       Json?
  /// [{ channel, text, hashtags, fact_ids, scores, rounds, needs_review, source }]
  posts          Json
  overall_score  Float?
  /// Bài sau khi chủ tiệm sửa rồi duyệt — nguồn học phong cách tiệm (Đợt 4).
  approved_posts Json?

  /// DRAFT | APPROVED | SCHEDULED
  status          String  @default("DRAFT")
  /// Mã bài bên SocialFlow sau khi gửi Lịch đăng (Đợt 3).
  social_post_ids Json?
  created_by      String
  approved_by     String?

  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  // Thùng rác 30 ngày (Kho dữ liệu v2, L-4 — PO 05/11/2026): quá hạn thì cron xoá vĩnh viễn.
  trashed_at  DateTime? @db.Timestamptz(3)
  purge_after DateTime? @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products? @relation("fk_content_generations_product_id", fields: [product_id], references: [id], onDelete: SetNull)

  @@index([organization_id, asset_id, topic_id, mode])
  @@index([organization_id, created_at])
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([purge_after])
}

/// Giọng nhân bản của chủ tiệm (Khu vực C — Voice Clone, 24/09/2026). TENANT.
/// Mẫu giọng lưu ở kho (`sample_storage_key`); worker `audio.voice_clone` gửi
/// mẫu lên ElevenLabs Instant Voice Clone và ghi `provider_voice_id`.
model voice_clones {
  id                 String    @id @default(uuid())
  organization_id    String
  name               String
  provider           String    @default("elevenlabs")
  provider_voice_id  String?
  /// PENDING | READY | FAILED | DELETED
  status             String    @default("PENDING")
  sample_storage_key String
  sample_mime_type   String
  sample_bytes       Int
  /// Câu cam kết người dùng đã tick (lưu nguyên văn để đối soát).
  consent_text       String
  consented_by       String
  consented_at       DateTime  @db.Timestamptz(3)
  job_id             String?
  error              String?
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)
  deleted_at         DateTime? @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
}

/// Nhạc nền do tiệm tự tải (Khu vực C — Music Select, 24/09/2026). TENANT.
/// Thư viện hệ thống nằm ở `music-catalog.ts` (có trường giấy phép), không ở bảng này.
model music_tracks {
  id               String    @id @default(uuid())
  organization_id  String
  title            String
  /// romantic | upbeat | chill | warm | luxury
  mood             String
  storage_key      String
  mime_type        String
  file_bytes       Int
  duration_seconds Float?
  /// owned | royalty_free | licensed | creative_commons
  license_type     String
  /// Nơi mua / đường dẫn giấy phép / tác giả — bắt buộc.
  license_source   String
  license_note     String?
  attested_by      String
  attested_at      DateTime  @db.Timestamptz(3)
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  deleted_at       DateTime? @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, mood])
}

// ── Chức năng 12: Điều phối Đơn hàng & Control Tower ─────────────────────────

enum order_payment_kind {
  DEPOSIT
  BALANCE
  REFUND
}

enum order_info_request_status {
  OPEN
  SENT
  WAITING
  RECEIVED
  OVERDUE
  CANCELLED
}

enum order_change_type {
  PRODUCT
  FLOWERS
  COLOR
  WRAPPING
  ACCESSORY
  CARD_MESSAGE
  ADDRESS
  RECIPIENT
  DELIVERY_DATE
  DELIVERY_TIME
  PRICE
  QUANTITY
  PARTNER
  OTHER
}

enum order_change_request_status {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

enum coordinator_stage {
  INTAKE
  VALIDATING
  PLANNING
  ASSIGNING
  IN_PRODUCTION
  QUALITY_CHECK
  DISPATCHING
  DELIVERED
  COMPLETED
  EXCEPTION
  CANCELLED
}

enum coordination_risk_level {
  NORMAL
  ATTENTION
  AT_RISK
  CRITICAL
}

enum qc_record_status {
  PENDING
  PASSED
  REJECTED
  REWORK_REQUESTED
}

/// Mạng lưới đối tác xưởng ngoài / thợ cắm hoa. TENANT ISOLATION.
model partners {
  id              String   @id @default(uuid())
  organization_id String
  code            String
  name            String
  /// @pii contact
  phone           String
  /// @pii address
  address         String?
  district        String?
  province        String?
  tier            String   @default("STANDARD")
  rating          Decimal  @default(5.0) @db.Decimal(3, 2)
  capacity_daily  Int      @default(10)
  is_active       Boolean  @default(true)
  /// ĐP-3 — giá trị trường tự tạo (entity = PARTNER).
  custom_fields   Json?
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization  organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  coordinations order_coordinations[]

  @@unique([organization_id, code])
  @@index([organization_id, is_active])
}

/// Hồ sơ điều phối tiến trình của từng đơn hàng. TENANT ISOLATION.
model order_coordinations {
  id                    String                  @id @default(uuid())
  organization_id       String
  order_id              String                  @unique
  partner_id            String?
  coordinator_id        String?
  stage                 coordinator_stage       @default(INTAKE)
  risk_level            coordination_risk_level @default(NORMAL)
  risk_reason           String?
  next_action           String?
  next_action_due       DateTime?               @db.Timestamptz(3)
  estimated_delivery_at DateTime?               @db.Timestamptz(3)
  actual_delivery_at    DateTime?               @db.Timestamptz(3)
  /// Bước quay về khi mọi sự cố của đơn đã xử lý xong (stage = EXCEPTION).
  resume_stage          coordinator_stage?
  production_progress   Int                     @default(0)
  /// Mảng id `assets` cùng tổ chức — ảnh thành phẩm thợ gửi lên.
  finished_asset_ids    Json?
  /// Ảnh mẫu tải lên lúc tiếp nhận (id `assets`), khi không lấy từ Product Master.
  sample_asset_id       String?
  shipper_name          String?
  /// @pii contact
  shipper_phone         String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `shipper_phone` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii contact
  shipper_phone_enc     String?
  carrier               String?
  /// PICKED_UP · ON_THE_WAY · DELIVERED_SUCCESS · DELIVERY_FAILED (F12).
  delivery_state        String?
  pod_asset_id          String?
  /// @pii identity
  pod_recipient_name    String?
  pod_captured_at       DateTime?               @db.Timestamptz(3)
  partner_payout_vnd    Decimal?                @db.Decimal(14, 2)
  partner_rating        Int?
  closure_notes         String?
  closed_by             String?
  closed_at             DateTime?               @db.Timestamptz(3)
  cancelled_reason      String?
  metadata              Json?
  /// ĐP-3 — giá trị trường tự tạo (Console Vận hành > Trường dữ liệu), theo
  /// định nghĩa đang ACTIVE trong `field_definitions` (entity = ORDER).
  custom_fields         Json?

  // ── ĐP-4a.1 (26/09/2026) — T01: đủ trường P0/P1 (Đặc tả trường §2.1/§3.1) ──
  /// `ORDER_M10` · `CHAT_M08` · `CATALOG_M06` · `MANUAL` (order-ingestion-connector.ts).
  source                 String?
  source_reference       String?
  /// Danh mục §2.15.3 (MỞ) — mã chuỗi kiểm active ở tầng ứng dụng, không Prisma enum (D12).
  channel                String?
  /// Danh mục §2.15.4 (CÓ HÀNH VI ORDER_TYPE) — kích hoạt nhóm trường có điều kiện §12.
  order_type             String?
  /// Danh mục §2.15.1 (CÓ HÀNH VI PRIORITY_TIER) — máy GỢI Ý, người quyết định cuối.
  priority               String?
  /// Danh mục §2.15.2 (CÓ HÀNH VI SLA) — dùng tính `estimated_delivery_at` (ĐP-4a.2).
  service_level          String?
  /// Danh mục §2.15.5 (CÓ HÀNH VI DELIVERY_TYPE).
  delivery_type          String?
  /// Danh mục §2.15.5 (CÓ HÀNH VI DELIVERY_LOCATION) — kích hoạt nhóm trường có điều kiện §12.
  delivery_location_type String?
  /// `cardMessage` bắt buộc khi cột này = true (kiểm ở `http-schemas.ts`).
  card_required          Boolean   @default(false)
  /// Thời điểm đơn THỰC SỰ đến (khác `created_at` khi đơn đến từ kênh ngoài có độ trễ nhập liệu).
  received_at            DateTime? @db.Timestamptz(3)
  /// Dùng khi `service_level = TIME_SLOT` (§2.15.2).
  delivery_window_start  DateTime? @db.Timestamptz(3)
  delivery_window_end    DateTime? @db.Timestamptz(3)
  /// Hạn sản xuất xong — tính ngược từ SLA giao (ĐP-4a.2/4a.9), CHƯA tính ở đợt 4a.1.
  production_deadline_at DateTime? @db.Timestamptz(3)
  /// Hạn lấy hàng đi giao — tính ngược từ SLA giao (ĐP-4a.2/4a.9), CHƯA tính ở đợt 4a.1.
  pickup_target_at       DateTime? @db.Timestamptz(3)
  /// Người phụ trách bán (§2.1) — gán = người tạo đơn lúc tiếp nhận, giống `coordinator_id`;
  /// chưa có API đổi người phụ trách (cùng tình trạng "MỘT PHẦN" như `coordinator_id`).
  sales_owner_id         String?
  /// Người phụ trách hành động kế tiếp — CHƯA gán ở đợt 4a.1 (thuộc luồng bàn giao T02, ĐP-4a.5).
  next_action_owner_id   String?
  /// Mốc bàn giao Sales → Điều phối (T02) — CHƯA ghi ở đợt 4a.1 (ĐP-4a.5).
  handoff_at             DateTime? @db.Timestamptz(3)

  // ── ĐP-4a.5 (27/09/2026) — T02: xác nhận bàn giao Sales → Điều phối ──────
  /// true khi Điều phối đã nhận bàn giao (đặt cùng lúc với `handoff_at`, lúc rời INTAKE).
  handoff_confirmed Boolean @default(false)

  // ── ĐP-4a.3 bù (27/09/2026) — Điều phối đặt cách thu + hạn thu phần còn lại ──
  /// Danh mục §2.15.7 (MỞ) — mã chuỗi kiểm active ở tầng ứng dụng (D12).
  collection_method String?
  collection_due_at DateTime? @db.Timestamptz(3)

  // ── ĐP-4a.9 (27/09/2026) — Form Lập kế hoạch đơn (Đặc tả trường §4.2) ────
  /// Mốc điều phối viên lập kế hoạch xong (khác `created_at`/`handoff_at`).
  planned_at                    DateTime? @db.Timestamptz(3)
  production_buffer_minutes     Int?
  pickup_buffer_minutes         Int?
  planned_production_minutes    Int?
  planned_qc_buffer_minutes     Int?
  planned_pickup_minutes        Int?
  planned_delivery_minutes      Int?
  partner_selection_deadline_at DateTime? @db.Timestamptz(3)
  technical_instruction         String?

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  partner      partners?     @relation(fields: [partner_id], references: [id])

  @@unique([order_id, organization_id]) // khoá ghép 1-1 về orders (05/11/2026)
  @@index([organization_id, stage])
  @@index([organization_id, risk_level])
  @@index([partner_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Sổ thu (ĐP-4a, 26/09/2026, PO D2). Mỗi lần thu/hoàn tiền là MỘT DÒNG.
/// `orders.paid_vnd`/`balance_vnd` được máy chủ cập nhật CÙNG giao dịch với
/// dòng này (`record-payment.ts`). TENANT ISOLATION.
model order_payments {
  id                String             @id @default(uuid())
  organization_id   String
  order_id          String
  kind              order_payment_kind
  amount_vnd        Decimal            @db.Decimal(14, 2)
  /// Danh mục §2.15.7 (`CASH`·`BANK_TRANSFER`·`COD`·`CARD`·`E_WALLET`·`OTHER`).
  /// Mã chuỗi kiểm theo danh mục — không dùng Prisma enum (D12).
  payment_method    String?
  /// Mã giao dịch chuyển khoản/ví, số biên nhận.
  reference         String?
  /// Ảnh chuyển khoản/biên nhận — id `assets` cùng tổ chức.
  evidence_asset_id String?
  collected_by      String
  collected_at      DateTime           @default(now()) @db.Timestamptz(3)
  note              String?
  /// ĐP-3 — trường tự tạo (entity = ORDER, đặt trên dòng sổ thu — dự phòng cho tương lai).
  custom_fields     Json?
  /// PENDING (Sale/Điều phối ghi, chờ Điều hành xác nhận — chưa cộng vào paid_vnd) · CONFIRMED · REJECTED.
  /// PO 04/11/2026, checklist ALG 1.16 (Q3 phương án b). Dòng cũ: CONFIRMED.
  status            String             @default("CONFIRMED")
  created_at        DateTime           @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, order_id])
  @@index([organization_id, status])
}

/// Yêu cầu bổ sung thông tin còn thiếu (T03, ĐP-4a.6, 27/09/2026, Đặc tả
/// trường §3.3). Dùng lại `MissingInfoRequestCard` (trước đó dựng sẵn
/// nhưng không được render — dashboard đang mở SỰ CỐ loại
/// `MISSING_INFORMATION` thay vì tạo yêu cầu riêng). TENANT ISOLATION.
model order_info_requests {
  id                   String                    @id @default(uuid())
  organization_id      String
  order_id             String
  /// Khoá trường lõi (`field-registry.ts`) hoặc trường tự tạo đang thiếu.
  missing_field        String
  field_label          String
  reason               String
  business_impact      String?
  /// Hỏi ai — mô tả tự do (khách qua Zalo, SĐT khách…), KHÔNG phải id có cấu trúc.
  requested_from       String
  requested_by         String
  requested_at         DateTime                  @default(now()) @db.Timestamptz(3)
  due_at               DateTime?                 @db.Timestamptz(3)
  /// Danh mục §2.15.3 (kênh hỏi lại — có thể khác kênh nhận đơn gốc).
  channel              String?
  message_template     String?
  response_required    Boolean                   @default(true)
  response_value       String?
  response_received_at DateTime?                 @db.Timestamptz(3)
  status               order_info_request_status @default(OPEN)
  cancelled_reason     String?
  created_at           DateTime                  @default(now()) @db.Timestamptz(3)
  updated_at           DateTime                  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, order_id])
  @@index([organization_id, status])
}

/// Yêu cầu thay đổi đơn (T04, ĐP-4a.7, 27/09/2026, Đặc tả trường §3.4 —
/// bản ĐẦY ĐỦ của Quy tắc Override, Hợp đồng MI §6, thay cho bản tối thiểu
/// `diffAgainstSnapshot` chỉ so một lần lúc tạo đơn). TENANT ISOLATION.
model order_change_requests {
  id                 String                      @id @default(uuid())
  organization_id    String
  order_id           String
  requested_by       String
  requested_at       DateTime                    @default(now()) @db.Timestamptz(3)
  change_type        order_change_type
  /// Đường dẫn trường bị đổi (khớp khoá `field-registry.ts` khi có, hoặc `bom.flowers[…]`…).
  field_changed      String
  /// Máy chủ tự đọc giá trị HIỆN TẠI qua `buildOrderFieldValueLookup` — không tin client
  /// (yếu tố 1+6 của Quy tắc Override: "chỉ ra giá trị nguồn" + "giữ nguyên giá trị gốc").
  old_value          String?
  new_value          String?
  reason             String
  customer_impact    String?
  production_impact  String?
  delivery_impact    String?
  /// Chênh lệch tiền khi `change_type = PRICE` (âm = giảm giá). Dùng tính lại `balance_vnd`.
  cost_impact_vnd    Decimal?                    @db.Decimal(14, 2)
  /// PRICE/QUANTITY luôn cần duyệt trước khi áp dụng — xem `create-order-change-request.ts`.
  requires_approval  Boolean                     @default(false)
  approved_by        String?
  approved_at        DateTime?                   @db.Timestamptz(3)
  /// true khi đã báo đối tác — mặc định false; nếu đơn đã phân công lúc tạo yêu cầu,
  /// view tính cờ DERIVED `needsPartnerNotice = partnerId != null && !partnerNotified`.
  partner_notified   Boolean                     @default(false)
  customer_confirmed Boolean                     @default(false)
  effective_at       DateTime?                   @db.Timestamptz(3)
  status             order_change_request_status @default(PENDING)
  rejected_reason    String?
  created_at         DateTime                    @default(now()) @db.Timestamptz(3)
  updated_at         DateTime                    @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, order_id])
  @@index([organization_id, status])
}

/// Hồ sơ kiểm tra chất lượng sản phẩm hoa cắm (QC). TENANT ISOLATION.
model order_qc_records {
  id               String           @id @default(uuid())
  organization_id  String
  order_id         String
  inspector_id     String?
  status           qc_record_status @default(PENDING)
  /// Điểm chấm AI — CHỈ ghi khi có lượt Vision thật (nợ #140), không nhận từ client.
  ai_score         Int?
  ai_critique      String?
  /// Mảng id `assets` cùng tổ chức — ảnh thành phẩm đã kiểm.
  image_asset_ids  Json?
  checklist_result Json?
  notes            String?
  created_at       DateTime         @default(now()) @db.Timestamptz(3)
  updated_at       DateTime         @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, order_id])
}

/// Nhật ký sự cố và ngoại lệ phát sinh trong quá trình điều phối. TENANT ISOLATION.
model order_exceptions {
  id              String    @id @default(uuid())
  organization_id String
  order_id        String
  code            String
  type            String
  severity        String    @default("MEDIUM")
  description     String
  resolution      String?
  status          String    @default("OPEN")
  reported_by     String?
  resolved_by     String?
  resolved_at     DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([organization_id, code])
  @@index([organization_id, order_id])
  @@index([organization_id, status])
}

// ── Journey Runs & Decision Registry (Patch v2.3 / P1 & P2) ──────────────────

/// Lượt thực thi của Journey theo Manifest v2 (Manual/Automatic)
model journey_runs {
  id               String   @id @default(uuid())
  organization_id  String
  workspace_id     String?
  manifest_id      String
  execution_mode   String   @default("manual") // manual | automatic
  status           String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  params           Json?
  context_snapshot Json?
  degraded_steps   Json?
  created_by       String
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_at       DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_workspace workspaces? @relation("fk_journey_runs_workspace_id", fields: [workspace_id], references: [id], onDelete: SetNull)

  @@index([organization_id, manifest_id])
  @@index([organization_id, status])
  @@index([workspace_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Sổ đăng ký quyết định (Decision Registry - 19 dòng chuẩn D-*)
model decision_registry {
  decision_id String  @id
  ownership   String // USER | SYSTEM | SHARED
  locked      Boolean @default(false)
  description String
  spec_ref    String?

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)
}

// ── Module Thẻ Chào / Swipe Brochure (greeting-card) ─────────────────────────

/// Danh mục mẫu hoa dùng để tạo thẻ chào (Chuẩn hoặc Client Catalog)
model greeting_catalogs {
  id              String    @id @default(uuid())
  organization_id String
  code            String // 20-10, 8-3, sinh-nhat, cc
  name            String
  type            String    @default("STANDARD") // STANDARD | CLIENT
  description     String?
  filters         Json? // Bộ lọc dịp, mức giá, màu sắc khi tạo Client Catalog
  is_active       Boolean   @default(true)
  created_by      String
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  // Thùng rác 30 ngày (Kho dữ liệu v2, L-4 — PO 05/11/2026): quá hạn thì cron xoá vĩnh viễn.
  trashed_at      DateTime? @db.Timestamptz(3)
  purge_after     DateTime? @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  items        greeting_catalog_products[]
  sessions     greeting_sessions[]

  catalog_events greeting_catalog_events[]
  share_links    greeting_share_links[]

  @@unique([organization_id, code])
  @@index([organization_id])
  @@index([purge_after])
}

/// Sản phẩm gán vào Catalog Thẻ chào (tham chiếu Product Master SSOT)
model greeting_catalog_products {
  id              String   @id @default(uuid())
  organization_id String
  catalog_id      String
  product_id      String
  sort_order      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  catalog      greeting_catalogs @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  product      products          @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([catalog_id, product_id])
  @@index([organization_id, catalog_id])
  @@index([product_id])
}

/// Phiên tương tác của khách hàng khi mở link Thẻ chào (Send Code)
model greeting_sessions {
  id                             String    @id @default(uuid())
  organization_id                String
  catalog_id                     String
  send_code                      String // T01-001, T01-002...
  sale_id                        String // Người tạo link chào khách
  /// @pii identity
  customer_name                  String?
  /// @pii contact
  customer_phone                 String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `customer_phone` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii contact
  customer_phone_enc             String?
  /// P-5a: HMAC-SHA256 của số đã chuẩn hoá (khoá riêng của tổ chức) — khớp đúng số, thay tìm theo chuỗi rõ
  /// @pii contact
  customer_phone_hash            String?
  /// P-5a: 4 số cuối dạng rõ — ô tìm kiếm (PO D-49)
  /// @pii contact
  customer_phone_last4           String?
  /// ADR-014 D-P2, P-2: hồ sơ khách cùng tổ chức (khách của đơn, hoặc khách PROSPECT theo SĐT trên link). Giai đoạn ghi
  /// kép: `customer_name`/`customer_phone` vẫn ghi; link chỉ có tên (không SĐT) thì để trống.
  customer_id                    String?
  status                         String    @default("CREATED") // CREATED | OPENED | BROWSING | SELECTED | ORDER_SUBMITTED | PAYMENT_REPORTED | COMPLETED
  selected_product_id            String?
  product_snapshot               Json? // Đóng băng ảnh, tên, giá mẫu hoa lúc khách chốt
  order_id                       String?
  /// Ảnh chuyển khoản lần 1 (đặt cọc / trả đủ) do khách tải lên
  payment_proof_asset_id         String?
  /// Ảnh chuyển khoản lần 2 (phần còn lại) do khách tải lên
  payment_proof_balance_asset_id String?
  opened_at                      DateTime? @db.Timestamptz(3)
  selected_at                    DateTime? @db.Timestamptz(3)
  /// Hết hạn link (null = không hết hạn). Hết hạn/thu hồi mà chưa có đơn → link trả 404.
  expires_at                     DateTime? @db.Timestamptz(3)
  revoked_at                     DateTime? @db.Timestamptz(3)
  revoked_by                     String?
  last_active_at                 DateTime  @default(now()) @db.Timestamptz(3)
  created_at                     DateTime  @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  catalog      greeting_catalogs         @relation(fields: [catalog_id], references: [id], onDelete: Cascade)
  order        orders?                   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  customer     customers?                @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  events       greeting_journey_events[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_selected_product             products?           @relation("fk_greeting_sessions_selected_product_id", fields: [selected_product_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  orders_by_source_session_id     orders[]            @relation("fk_orders_source_session_id")
  greeting_messages_by_session_id greeting_messages[] @relation("fk_greeting_messages_session_id")

  @@unique([organization_id, send_code])
  @@unique([id, organization_id]) // đích của khoá ghép tenant (05/11/2026)
  @@index([organization_id, catalog_id])
  @@index([organization_id, sale_id])
  @@index([send_code])
  @@index([catalog_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([selected_product_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([customer_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([organization_id, customer_phone_hash])
}

/// Tích hợp ngoài của Thẻ chào theo tiệm: webhook đối soát ngân hàng + kênh
/// thông báo khách. Khoá webhook chỉ lưu BĂM (sha256); thông tin đăng nhập
/// Zalo/eSMS lưu MÃ HOÁ (AES-256-GCM) — không bao giờ trả ra client.
model greeting_integrations {
  id                            String   @id @default(uuid())
  organization_id               String   @unique
  payment_provider              String? // SEPAY
  payment_webhook_key_hash      String?  @unique
  payment_webhook_key_hint      String? // 4 ký tự cuối, để nhận diện khoá
  payment_webhook_enabled       Boolean  @default(false)
  notify_channel                String? // ZNS | ESMS
  notify_enabled                Boolean  @default(false)
  notify_config_encrypted       String?
  notify_templates              Json? // mã mẫu tin theo sự kiện — không bí mật
  staff_notify_enabled          Boolean  @default(false)
  staff_notify_channels         Json? // Mảng kênh đã bật: ["TELEGRAM", "ZALO", ...]
  staff_notify_config_encrypted String? // Thông tin kết nối mã hoá (Bot Token, Chat ID, App Secret...)
  staff_notify_events           Json? // Bật/tắt theo sự kiện
  created_at                    DateTime @default(now()) @db.Timestamptz(3)
  updated_at                    DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
}

/// Giao dịch ngân hàng nhận qua webhook (SePay…). Unique theo mã giao dịch của
/// nhà cung cấp → webhook gửi lại không ghi thu hai lần.
model greeting_payment_events {
  id              String    @id @default(uuid())
  organization_id String
  provider        String // SEPAY
  external_id     String
  amount_vnd      Decimal   @db.Decimal(14, 2)
  content         String
  account_no      String?
  transaction_at  DateTime? @db.Timestamptz(3)
  status          String // MATCHED | UNMATCHED | IGNORED
  order_id        String?
  payment_id      String?
  note            String?
  created_at      DateTime  @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order orders? @relation("fk_greeting_payment_events_order_id", fields: [order_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, provider, external_id])
  @@index([organization_id, status])
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Nhật ký tin đã gửi cho khách (Zalo ZNS / SMS) theo từng mốc đơn. Unique
/// theo (đơn, sự kiện) → một mốc chỉ gửi một lần dù thao tác bị bấm lại.
model greeting_notifications {
  id                  String   @id @default(uuid())
  organization_id     String
  order_id            String
  event_key           String // PAYMENT_CONFIRMED | READY | DISPATCHED | DELIVERED | CANCELLED
  channel             String // ZNS | ESMS
  recipient_masked    String
  status              String // SENT | FAILED | SKIPPED
  provider_message_id String?
  error               String?
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order orders @relation("fk_greeting_notifications_order_id", fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([organization_id, order_id, event_key])
  @@index([organization_id, order_id])
}

/// Nhật ký thông báo nhân viên Thẻ Chào (Đa kênh: APP_INBOX, ZALO, TELEGRAM, WHATSAPP, MESSENGER, SMS)
model staff_notifications {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String?
  event_key       String
  channel         String // APP_INBOX | ZALO | SMS | TELEGRAM | WHATSAPP | MESSENGER
  recipient_role  String? // ADMIN | SALE | COORDINATOR
  recipient_id    String? // user_id hoặc null nếu broadcast toàn bộ vai trò
  recipient_info  String? // SĐT, Telegram Chat ID, Zalo User ID...
  title           String?
  message         String?
  status          String   @default("SENT") // SENT | FAILED | SKIPPED
  provider_msg_id String?
  error           String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order orders? @relation("fk_staff_notifications_order_id", fields: [order_id], references: [id], onDelete: SetNull)

  @@index([organization_id, event_key])
  @@index([organization_id, recipient_id])
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Ghi nhật ký hành trình tương tác của khách trên Thẻ chào (Swipe, Select, Checkout...)
/// Phễu link dùng chung (`/bst`, `/g`) theo kênh — PO duyệt 06/10/2026 (mục 16).
/// Một dòng mỗi bước của một người xem; `visitor_hash` là băm ngẫu nhiên trên máy
/// khách (không IP, không SĐT). Đơn đặt từ link ghi thêm bước ORDER kèm order_id.
/**
 * Link bộ sưu tập do một nhân viên sao chép (06/10/2026, PO duyệt): người bấm "Sao chép" chịu
 * trách nhiệm mọi khách mở link đó. Mỗi khách mở `/s/<code>` có một phiên riêng
 * (`greeting_sessions`, `sale_id` = người sao chép) — theo dõi từ lúc mở tới khi xong đơn.
 */
model greeting_share_links {
  id              String    @id @default(uuid())
  organization_id String
  code            String    @unique // mã trong `/s/<code>` — ngẫu nhiên, không đoán được
  catalog_id      String
  owner_id        String // người đã bấm Sao chép
  channel         String? // ?kenh= lúc sao chép
  created_at      DateTime  @default(now()) @db.Timestamptz(3) // = lúc sao chép
  revoked_at      DateTime? @db.Timestamptz(3)

  organization organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  catalog      greeting_catalogs @relation(fields: [catalog_id], references: [id], onDelete: Cascade)

  @@index([organization_id, owner_id, created_at])
  @@index([organization_id, catalog_id])
  @@index([catalog_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Tin nhắn nội bộ Thẻ chào theo đơn/link (06/10/2026, PO duyệt): người gửi lấy từ phiên,
 * gửi cho một vai (ADMIN/SALE/COORDINATOR) hoặc một người cụ thể; trả lời đi thẳng về
 * người gửi. `kind` để mở rộng (vd. xin giảm giá) mà không cần bảng mới.
 */
model greeting_messages {
  id              String   @id @default(uuid())
  organization_id String
  order_id        String? // đơn đã đặt
  session_id      String? // link chưa có đơn
  step_key        String   @default("GENERAL") // GENERAL | STEP_x của quy trình theo dõi
  sender_id       String
  sender_role     String // ADMIN | SALE | COORDINATOR — suy từ năng lực, không nhận từ client
  to_role         String? // gửi cho cả vai
  to_user_id      String? // gửi cho một người (trả lời luôn vào đây)
  kind            String   @default("MESSAGE") // MESSAGE
  body            String
  payload         Json?
  reply_to_id     String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  reads        greeting_message_reads[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order                         orders?             @relation("fk_greeting_messages_order_id", fields: [order_id], references: [id], onDelete: SetNull)
  fk_session                       greeting_sessions?  @relation("fk_greeting_messages_session_id", fields: [session_id], references: [id], onDelete: SetNull)
  fk_reply_to                      greeting_messages?  @relation("fk_greeting_messages_reply_to_id", fields: [reply_to_id], references: [id], onDelete: SetNull)
  // Quan hệ ngược của khoá ngoại thêm 05/11/2026
  greeting_messages_by_reply_to_id greeting_messages[] @relation("fk_greeting_messages_reply_to_id")

  @@index([organization_id, order_id])
  @@index([organization_id, session_id])
  @@index([organization_id, to_user_id, created_at])
  @@index([organization_id, to_role, created_at])
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([reply_to_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([session_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/**
 * Ai đã đọc tin nào — lưu ở máy chủ để điện thoại và máy tính cùng hết báo.
 */
model greeting_message_reads {
  id              String   @id @default(uuid())
  organization_id String
  message_id      String
  user_id         String
  read_at         DateTime @default(now()) @db.Timestamptz(3)

  organization organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  message      greeting_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@index([organization_id, user_id])
}

model greeting_catalog_events {
  id              String   @id @default(uuid())
  organization_id String
  catalog_id      String
  channel         String // zalo | facebook | instagram | tiktok | website | khac | truc-tiep (?kenh= lạ/trống)
  event_type      String // VIEW | DETAIL | FORM_OPEN | ORDER | LIKE | UNLIKE
  visitor_hash    String // sha256(catalog_id:mã khách ngẫu nhiên) — không lưu IP
  order_id        String?
  product_id      String? // LIKE/UNLIKE: mẫu được thả/bỏ tim (07/10/2026)
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  catalog      greeting_catalogs @relation(fields: [catalog_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products? @relation("fk_greeting_catalog_events_product_id", fields: [product_id], references: [id], onDelete: SetNull)
  fk_order   orders?   @relation("fk_greeting_catalog_events_order_id", fields: [order_id], references: [id], onDelete: SetNull)

  @@index([organization_id, catalog_id, created_at])
  @@index([organization_id, channel])
  @@index([organization_id, catalog_id, product_id])
  @@index([catalog_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([product_id]) // khoá ngoại cần index (ADR-015 O-1)
}

model greeting_journey_events {
  id              String   @id @default(uuid())
  organization_id String
  session_id      String
  event_type      String // OPEN | SWIPE_NEXT | SWIPE_PREV | SELECT_PRODUCT | OPEN_ORDER_FORM | SUBMIT_ORDER | CLICK_PAID | TRACK_VIEW
  metadata        Json?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  session      greeting_sessions @relation(fields: [session_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id, session_id])
}

// ─── Internal Chat (ChainOS / PlatformOS) ────────────────────────────────────
model internal_chat_conversations {
  id                String   @id @default(uuid())
  organization_id   String
  conversation_type String // PLATFORM_TENANT | CHAIN_PARTNER | ORDER_THREAD
  title             String?
  order_id          String?
  metadata          Json     @default("{}")
  created_by        String // user_id of creator
  last_message_at   DateTime @default(now()) @db.Timestamptz(3)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)

  organization organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  participants internal_chat_participants[]
  messages     internal_chat_messages[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order orders? @relation("fk_internal_chat_conversations_order_id", fields: [order_id], references: [id], onDelete: SetNull)

  @@unique([id, organization_id])
  @@index([organization_id, conversation_type])
  @@index([order_id])
}

model internal_chat_participants {
  id              String   @id @default(uuid())
  conversation_id String
  user_id         String
  organization_id String
  role_in_chat    String   @default("MEMBER") // OWNER | ADMIN | MEMBER | GUEST_PARTNER
  last_read_at    DateTime @default(now()) @db.Timestamptz(3)
  is_muted        Boolean  @default(false)
  joined_at       DateTime @default(now()) @db.Timestamptz(3)

  updated_at   DateTime                    @default(now()) @updatedAt @db.Timestamptz(3)
  conversation internal_chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  organization organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         users                       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id, organization_id])
  @@index([organization_id])
}

model internal_chat_messages {
  id              String    @id @default(uuid())
  conversation_id String
  /// Sao từ internal_chat_conversations; trigger điền khi bên ghi bỏ trống.
  organization_id String
  sender_user_id  String
  sender_role     String
  message_type    String    @default("TEXT") // TEXT | IMAGE | ACTION_CARD_ORDER | ACTION_CARD_QC | SYSTEM_NOTICE
  content         String    @default("")
  attachments     String[]  @default([])
  action_payload  Json?
  /// Xoá mềm thống nhất bằng mốc thời gian (thay is_deleted, 05/11/2026).
  deleted_at      DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)

  updated_at   DateTime                    @default(now()) @updatedAt @db.Timestamptz(3)
  conversation internal_chat_conversations @relation(fields: [conversation_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  organization organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  sender       users                       @relation("ChatSender", fields: [sender_user_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@index([organization_id])
  @@index([sender_user_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ─── Notification System (Multi-Tier, Multi-Role) ──────────────────────────
model notification_channel_activations {
  channel    String // APP_INBOX | EMAIL | PUSH | TELEGRAM | ZALO | SMS | WHATSAPP | MESSENGER
  activated  Boolean  @default(false)
  updated_by String // platform_admin user_id
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  created_at DateTime @default(now()) @db.Timestamptz(3)

  @@id([channel])
}

model notification_org_policies {
  id                String   @id @default(uuid())
  organization_id   String
  event_key         String
  channel           String
  role_key          String // RoleUxKey hoặc "*" cho all roles
  enabled           Boolean  @default(true)
  priority_override String? // NORMAL | URGENT | CRITICAL
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, event_key, channel, role_key])
  @@index([organization_id])
}

model notification_store_defaults {
  id              String   @id @default(uuid())
  organization_id String
  event_key       String
  channel         String
  role_key        String
  enabled         Boolean  @default(true)
  schedule_start  String? // "08:00"
  schedule_end    String? // "22:00"
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, event_key, channel, role_key])
  @@index([organization_id, role_key])
}

model notification_user_preferences {
  id              String    @id @default(uuid())
  user_id         String
  organization_id String
  event_key       String
  channel         String
  enabled         Boolean
  mute_until      DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id, event_key, channel])
  @@index([user_id, organization_id])
  @@index([organization_id])
}

model notification_inbox {
  id              String    @id @default(uuid())
  user_id         String
  organization_id String
  event_key       String
  title           String
  message         String
  deep_link       String?
  priority        String    @default("NORMAL")
  is_read         Boolean   @default(false)
  read_at         DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)

  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([user_id, organization_id, is_read])
  @@index([organization_id])
  @@index([user_id, organization_id, created_at])
}

// ─────────────────────────────────────────────────────────────────────────
// Nhóm công cụ 6 — Tính giá và tối ưu lợi nhuận (#31–#35), PO duyệt 29/10/2026.
// Đặc điểm theo ngành nằm ở `IndustryCostingSpec` (organization/domain/industry-costing-spec.ts);
// các bảng dưới đây là dữ liệu RIÊNG của từng cửa hàng (REQ-BND-007/008).
// ─────────────────────────────────────────────────────────────────────────

/// #32 — Nguyên liệu của cửa hàng. `unit_cost_vnd` null = chưa nhập giá (giá vốn báo thiếu, không đoán).
model materials {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  unit            String
  category_key    String // khoá trong IndustryCostingSpec.materialCategories của ngành
  unit_cost_vnd   Decimal? @db.Decimal(14, 2)
  supplier_name   String? // PO 29/10/2026: chỉ ghi tên nhà cung cấp, quản lý đầy đủ làm sau
  on_hand_qty     Decimal? @db.Decimal(14, 3) // tồn nhập tay (#35)
  active          Boolean  @default(true)
  created_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization  organizations            @relation(fields: [organization_id], references: [id])
  price_history material_price_history[]
  recipe_items  product_recipe_items[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@index([organization_id, category_key])
}

/// #32 — Lịch sử đơn giá: mỗi lần đổi giá ghi một dòng (cảnh báo biến động, truy vết).
model material_price_history {
  id              String   @id @default(uuid())
  organization_id String
  material_id     String
  unit_cost_vnd   Decimal  @db.Decimal(14, 2)
  source          String // MANUAL · IMPORT · PURCHASE
  effective_at    DateTime @default(now()) @db.Timestamptz(3)
  created_by      String

  organization organizations @relation(fields: [organization_id], references: [id])
  material     materials     @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, material_id, effective_at])
  @@index([material_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// #31 — Công thức (định mức) của một sản phẩm tại cửa hàng; một công thức hiện hành mỗi sản phẩm.
model product_recipes {
  id              String   @id @default(uuid())
  organization_id String
  product_id      String
  version         Int      @default(1)
  waste_percent   Decimal? @db.Decimal(5, 2) // null = dùng mặc định theo nhóm nguyên liệu của ngành
  labor_minutes   Int? // dùng khi ngành tính công theo phút
  note            String?
  updated_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization organizations          @relation(fields: [organization_id], references: [id])
  product      products               @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  items        product_recipe_items[]

  @@unique([organization_id, product_id])
  @@index([organization_id])
}

/// #31 — Một dòng định mức: nguyên liệu × số lượng cho một sản phẩm.
model product_recipe_items {
  id              String  @id @default(uuid())
  organization_id String
  recipe_id       String
  material_id     String
  quantity        Decimal @db.Decimal(14, 3)

  created_at   DateTime        @default(now()) @db.Timestamptz(3)
  organization organizations   @relation(fields: [organization_id], references: [id])
  recipe       product_recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  material     materials       @relation(fields: [material_id], references: [id])

  @@unique([recipe_id, material_id])
  @@index([organization_id])
  @@index([material_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ─── Trung tâm Tích hợp (Integration Hub, GĐ1 — 30/10/2026) ─────────────────
// Kế hoạch: docs/kien-truc/KE_HOACH_TRUNG_TAM_TICH_HOP.md

enum integration_connection_status {
  DRAFT
  CONNECTING
  ACTIVE
  DEGRADED
  EXPIRED
  ERROR
  DISCONNECTED
  DISABLED_BY_UPPER
}

enum integration_event_direction {
  IN
  OUT
}

enum integration_event_status {
  PENDING
  DONE
  FAILED
  DEAD
}

/// Một kết nối của tổ chức tới dịch vụ ngoài. Bí mật chỉ nằm trong `credential_encrypted` (secret-box);
/// `config` không chứa bí mật. `connection_ref` là mã ngẫu nhiên dùng trong URL webhook công khai.
model integration_connections {
  id                    String                        @id @default(uuid())
  organization_id       String
  connector_key         String
  scope_tier            String
  external_account_id   String                        @default("")
  display_name          String
  status                integration_connection_status @default(DRAFT)
  config                Json                          @default("{}")
  credential_encrypted  String?
  credential_hint       String?
  connection_ref        String                        @unique
  inherited_from_org_id String?
  expires_at            DateTime?                     @db.Timestamptz(3)
  last_health_at        DateTime?                     @db.Timestamptz(3)
  last_error_code       String?
  created_by            String
  created_at            DateTime                      @default(now()) @db.Timestamptz(3)
  updated_at            DateTime                      @updatedAt @db.Timestamptz(3)

  organization   organizations              @relation(fields: [organization_id], references: [id])
  events         integration_events[]
  cursors        integration_sync_cursors[]
  listings       sales_channel_listings[]
  channel_orders sales_channel_orders[]

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_inherited_from_org organizations? @relation("fk_integration_connections_inherited_from_org_id", fields: [inherited_from_org_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, connector_key, external_account_id])
  @@index([organization_id])
  @@index([status, last_health_at])
  @@index([inherited_from_org_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Nhật ký sự kiện vào (webhook) / ra (lệnh gọi) của một kết nối. Chống trùng theo
/// (connection, direction, external_event_id). Payload đã che dữ liệu cá nhân.
model integration_events {
  id                String                      @id @default(uuid())
  organization_id   String
  connection_id     String
  direction         integration_event_direction
  event_type        String
  external_event_id String?
  status            integration_event_status    @default(PENDING)
  attempts          Int                         @default(0)
  next_retry_at     DateTime?                   @db.Timestamptz(3)
  error_code        String?
  payload_redacted  Json                        @default("{}")
  created_at        DateTime                    @default(now()) @db.Timestamptz(3)
  updated_at        DateTime                    @updatedAt @db.Timestamptz(3)

  organization organizations           @relation(fields: [organization_id], references: [id])
  connection   integration_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, direction, external_event_id])
  @@index([organization_id])
  @@index([organization_id, connection_id, created_at])
  @@index([status, next_retry_at])
}

/// Con trỏ đồng bộ (đơn hàng, tồn kho…) theo kết nối.
model integration_sync_cursors {
  id              String   @id @default(uuid())
  organization_id String
  connection_id   String
  resource        String
  cursor          String
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  created_at   DateTime                @default(now()) @db.Timestamptz(3)
  organization organizations           @relation(fields: [organization_id], references: [id])
  connection   integration_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, resource])
  @@index([organization_id])
}

/// Một bảng quyết định theo tầng (ADR-012 D-T10): ma trận quản trị, khoá cứng + hiển thị thông báo, khoá tích hợp
/// (T-7c đã bỏ các nơi lưu cũ: `settings.governance_matrix`, `platform_settings` `governance_matrix:*`,
/// `notification_hard_locks`, `notification_event_visibility`, `integration_governance`).
/// Bảng cấp nền tảng: không có `organization_id`; phạm vi nằm ở `scope` (địa chỉ D-T5:
/// `platform` · `industry:<key>` · `org:<id>` · `branch:<id>`). Chỉ thêm dòng: mỗi lần đổi là một dòng mới; quyết định
/// hiện hành = dòng `version` lớn nhất của bộ (`system`, `decision_key`, `tier`, `scope`, `locked`); `value` null = đã gỡ.
model governance_decisions {
  id           String   @id @default(uuid())
  /// Thứ tự toàn cục (tăng dần) — dòng mới nhất của một quyết định là dòng hiện hành
  version      BigInt   @unique @default(autoincrement())
  /// `matrix:<SYSTEM>` · `notification.hard_lock` · `notification.visibility` · `integration`
  system       String
  decision_key String
  /// Tầng ra quyết định: MOTHER | INDUSTRY | CHAIN | STORE
  tier         String
  scope        String
  /// true = khoá cho tầng dưới; false = ghi đè / thiết lập của chính phạm vi
  locked       Boolean
  value        Json?
  decided_by   String?
  decided_at   DateTime @default(now()) @db.Timestamptz(3)

  @@index([system, scope, decision_key, tier, locked, version])
  @@index([scope])
}

// ─── Kênh bán hàng — phần chung (Trung tâm Tích hợp GĐ4A, PO 31/10/2026) ─────

enum sales_listing_status {
  PENDING
  SYNCED
  REJECTED
  REMOVED
}

enum sales_channel_order_status {
  IMPORTED
  FAILED
}

/// Sản phẩm ↔ tin đăng trên một kênh bán (theo kết nối). Một sản phẩm một tin mỗi kết nối.
model sales_channel_listings {
  id              String               @id @default(uuid())
  organization_id String
  connection_id   String
  product_id      String
  external_id     String?
  status          sales_listing_status @default(PENDING)
  last_error      String?
  last_synced_at  DateTime?            @db.Timestamptz(3)
  created_at      DateTime             @default(now()) @db.Timestamptz(3)
  updated_at      DateTime             @updatedAt @db.Timestamptz(3)

  organization organizations           @relation(fields: [organization_id], references: [id])
  connection   integration_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_product products @relation("fk_sales_channel_listings_product_id", fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([connection_id, product_id])
  @@index([organization_id])
  @@index([organization_id, product_id])
}

/// Đơn trên kênh bán ↔ đơn nội bộ. Unique theo (kết nối, mã đơn ngoài) → webhook/lượt kéo gửi lại không tạo đơn trùng.
model sales_channel_orders {
  id                String                     @id @default(uuid())
  organization_id   String
  connection_id     String
  external_order_id String
  order_id          String?
  status            sales_channel_order_status
  error_code        String?
  created_at        DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at        DateTime                   @updatedAt @db.Timestamptz(3)

  organization organizations           @relation(fields: [organization_id], references: [id])
  connection   integration_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // Khoá ngoại thêm ở đợt hoàn thiện CSDL 05/11/2026
  fk_order orders? @relation("fk_sales_channel_orders_order_id", fields: [order_id], references: [id], onDelete: SetNull)

  @@unique([connection_id, external_order_id])
  @@index([organization_id])
  @@index([organization_id, created_at])
  @@index([order_id]) // khoá ngoại cần index (ADR-015 O-1)
}

// ─── Thu hút khách hàng (Bước 4 — công cụ 12, 13, 21, 25) ─────────────────────
// Khách tiềm năng để lại SĐT từ trang công khai. Trước đây nằm trong
// catalog_links.filters.leads (JSON) — mất khi gửi đồng thời, không vào CRM.
model leads {
  id                 String    @id @default(uuid())
  organization_id    String
  customer_id        String?
  /// @pii identity
  name               String
  /// @pii contact
  phone              String
  /// ADR-014 P-5a: bản mã AES-256-GCM của `phone` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii contact
  phone_enc          String?
  /// P-5a: HMAC-SHA256 của số đã chuẩn hoá (khoá riêng của tổ chức) — khớp đúng số, thay tìm theo chuỗi rõ
  /// @pii contact
  phone_hash         String?
  /// P-5a: 4 số cuối dạng rõ — ô tìm kiếm (PO D-49)
  /// @pii contact
  phone_last4        String?
  message            String?
  /// ADR-014 P-5a: bản mã AES-256-GCM của `message` (khoá dữ liệu của tổ chức, `src/core/security/pii-cipher.ts`)
  /// @pii free_text
  message_enc        String?
  source             String // CATALOG_LINK | SHORT_LINK | LANDING | CHAT | MANUAL
  source_ref         String? // slug catalog hoặc mã link
  short_link_id      String?
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  consent_at         DateTime  @db.Timestamptz(3)
  consent_version    String
  /// 10 trạng thái pipeline: NEW, QUALIFIED, CONTACTED, CONSULTING, RECOMMENDED, QUOTATION_SENT, FOLLOW_UP, WON, LOST, UNQUALIFIED (PO 01/11/2026, PR-3).
  status             String    @default("NEW")
  assignee_user_id   String? // user thuộc memberships của tổ chức — kiểm ở use-case
  status_changed_at  DateTime? @db.Timestamptz(3)
  /// Đơn hàng đa nguồn (PO 31/10/2026, §3.3–3.4): lý do vào, hạn gọi lại, lý do đóng, đơn đã chuyển thành.
  /// CONTACT | QUOTE_REQUEST | ABANDONED | PAYMENT_TIMEOUT | WALK_IN | CHAT
  reason             String?
  next_follow_up_at  DateTime? @db.Timestamptz(3)
  /// NO_NEED | UNREACHABLE | BOUGHT_ELSEWHERE | INVALID
  closed_reason      String?
  converted_order_id String?
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)

  organization    organizations @relation(fields: [organization_id], references: [id])
  customer        customers?    @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  short_link      short_links?  @relation(fields: [short_link_id], references: [id], onDelete: SetNull)
  converted_order orders?       @relation("lead_converted_order", fields: [converted_order_id], references: [id], onDelete: SetNull)
  origin_orders   orders[]      @relation("order_origin_lead")
  quotations      quotations[]

  @@index([organization_id])
  @@index([organization_id, status, created_at])
  @@index([organization_id, phone, created_at])
  @@index([organization_id, next_follow_up_at])
  @@index([organization_id, converted_order_id])
  @@index([converted_order_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([customer_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([short_link_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([organization_id, phone_hash])
}

// Link/QR động: in một lần, đổi đích sau; mỗi điểm đặt (quầy, tờ rơi…) một mã để
// thống kê theo vị trí. Đích chỉ là đường dẫn nội bộ (chặn open redirect).
model short_links {
  id              String    @id @default(uuid())
  organization_id String
  code            String    @unique
  kind            String // QR | SALES_LINK
  name            String
  target_path     String
  placement_label String?
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  expires_at      DateTime? @db.Timestamptz(3)
  is_active       Boolean   @default(true)
  scan_count      Int       @default(0)
  created_by      String
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations  @relation(fields: [organization_id], references: [id])
  events       link_events[]
  leads        leads[]
  usages       asset_usages[]

  @@index([organization_id])
  @@index([organization_id, created_at])
}

// Lượt quét/bấm. Không lưu IP thô — chỉ băm theo ngày để đếm khách riêng.
model link_events {
  id              String   @id @default(uuid())
  organization_id String
  short_link_id   String
  device          String // MOBILE | TABLET | DESKTOP | UNKNOWN
  referrer_host   String?
  visitor_hash    String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  short_link   short_links   @relation(fields: [short_link_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, short_link_id, created_at])
  @@index([short_link_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Chợ đối tác (SaaS Mẹ) — hồ sơ khảo sát cửa hàng tiềm năng, CẤP NỀN TẢNG:
/// cửa hàng chưa là tenant nên không có organization_id (đặc tả 07).
/// Đọc cần N1, ghi (đồng bộ/nhập/ảnh) cần N17.
model partner_marketplace_stores {
  id               String   @id @default(uuid())
  /// Tên cửa hàng chuẩn hoá (thường, bỏ dấu cách thừa) — khoá khớp khi đồng bộ lại
  match_key        String   @unique
  shop_name        String
  tier             String
  /// @pii business
  address          String   @default("")
  /// Toàn bộ hồ sơ khảo sát (PartnerStoreMarketplaceEntity, trừ id)
  profile          Json
  /// Khoá kho ảnh đã tải (platform/partner-stores/<id>/…)
  photo_keys       String[] @default([])
  /// Drive id tương ứng photo_keys — đổi danh sách Drive thì tải lại
  photo_source_ids String[] @default([])
  search_text      String   @default("")
  source           String // SHEET · EXCEL · SEED
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_at       DateTime @updatedAt @db.Timestamptz(3)

  @@index([tier])
}

/// Link chia sẻ chợ đối tác (PO 01/11/2026): xem danh sách (đã che một phần) không cần
/// đăng nhập. Cấp nền tảng như partner_marketplace_stores — không có organization_id.
/// Tạo / huỷ cần N17. Chỉ lưu SHA-256 của token, không lưu token gốc.
model partner_marketplace_share_links {
  id             String    @id @default(uuid())
  token_hash     String    @unique
  /// Ghi chú để nhớ link gửi cho ai (vd. "BOD quý 4")
  label          String
  expires_at     DateTime  @db.Timestamptz(3)
  revoked_at     DateTime? @db.Timestamptz(3)
  created_by     String
  view_count     Int       @default(0)
  last_viewed_at DateTime? @db.Timestamptz(3)
  created_at     DateTime  @default(now()) @db.Timestamptz(3)

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([created_at])
}

/// Yêu cầu duyệt theo từng đơn — Đơn hàng đa nguồn (PO 31/10/2026, KIEN_TRUC_SSOT_DON_HANG_DA_NGUON.md §5).
/// Chỉ đơn NGOÀI Thẻ chào. `kind` hiện có: DELIVER_BEFORE_PAY (giao trước, thu sau cho đơn ngoài chính sách).
model order_approval_requests {
  id              String    @id @default(uuid())
  organization_id String
  order_id        String
  /// DELIVER_BEFORE_PAY
  kind            String
  /// PENDING | APPROVED | REJECTED | AUTO_APPROVED
  status          String    @default("PENDING")
  /// Căn cứ duyệt: SELF_LIMIT (trong hạn mức Sale tự quyết) | URGENT (đơn hoả tốc) | ADMIN (Điều hành duyệt)
  basis           String?
  reason          String
  requested_by    String
  requested_at    DateTime  @default(now()) @db.Timestamptz(3)
  decided_by      String?
  decided_at      DateTime? @db.Timestamptz(3)
  decision_note   String?
  /// Hạn thu tiền sau giao (Điều hành sửa được khi duyệt).
  collect_due_at  DateTime? @db.Timestamptz(3)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  order        orders        @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, status, created_at])
  @@index([organization_id, order_id])
}

enum usage_destination {
  PROMOTION
  SALES
  CARE
  PRINT
  OTHER
}

enum usage_status {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Nơi dùng tư liệu (Asset Usage) — Marketing & Sales Center (PO 01/11/2026, PR-2).
/// Liên kết một tư liệu nguồn (từ 8 LIBRARY_TYPES) với đích sử dụng và CTA,
/// gắn kèm link rút gọn để đo lường lượt quét/bấm và lead quy thuộc.
model asset_usages {
  id              String            @id @default(uuid())
  organization_id String
  /// 8 LIBRARY_TYPES (original, ai_image, video, audio, content, catalog, greeting_catalog, landing)
  source_type     String
  source_id       String
  asset_type_code String
  destination     usage_destination
  cta_code        String
  title           String
  short_link_id   String?
  campaign_id     String?
  config          Json?             @default("{}")
  status          usage_status      @default(ACTIVE)
  created_by      String
  created_at      DateTime          @default(now()) @db.Timestamptz(3)
  updated_at      DateTime          @updatedAt @db.Timestamptz(3)

  organization          organizations           @relation(fields: [organization_id], references: [id])
  short_link            short_links?            @relation(fields: [short_link_id], references: [id], onDelete: SetNull)
  campaign              campaigns?              @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  quotations            quotations[]
  customer_interactions customer_interactions[]
  print_renditions      print_renditions[]

  @@index([organization_id])
  @@index([organization_id, source_type, source_id])
  @@index([organization_id, destination, status])
  @@index([campaign_id])
  @@index([short_link_id]) // khoá ngoại cần index (ADR-015 O-1)
}

enum campaign_objective {
  AWARENESS
  LEAD
  SALE
  RETENTION
}

enum campaign_status {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Chiến dịch Quảng bá & Bán hàng — Marketing & Sales Center (PO 01/11/2026, PR-3).
/// Quản lý mục tiêu, dịp/sự kiện, thời gian chạy và tập hợp Asset Usages.
model campaigns {
  id              String             @id @default(uuid())
  organization_id String
  name            String
  objective       campaign_objective
  occasion_code   String?
  starts_at       DateTime?          @db.Timestamptz(3)
  ends_at         DateTime?          @db.Timestamptz(3)
  status          campaign_status    @default(DRAFT)
  created_by      String
  created_at      DateTime           @default(now()) @db.Timestamptz(3)
  updated_at      DateTime           @updatedAt @db.Timestamptz(3)

  organization organizations  @relation(fields: [organization_id], references: [id])
  usages       asset_usages[]

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, created_at])
}

enum quotation_status {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

/// Báo giá bán hàng (Quotations) — Marketing & Sales Center (PO 01/11/2026, PR-4).
/// Liên kết cơ hội từ Lead/Customer, tính toán sản phẩm & ưu đãi, chuyển đổi thành đơn hàng.
model quotations {
  id                 String           @id @default(uuid())
  organization_id    String
  code               String // VD: BG-0001 — mã nội bộ, không dùng cho link công khai
  public_token       String           @unique // token ngẫu nhiên của link công khai /bg/<token>
  lead_id            String?
  customer_id        String?
  asset_usage_id     String?
  status             quotation_status @default(DRAFT)
  valid_until        DateTime?        @db.Timestamptz(3)
  subtotal           Decimal          @default(0) @db.Decimal(12, 2)
  discount_amount    Decimal          @default(0) @db.Decimal(12, 2)
  /// Phí vận chuyển cộng vào tổng sau ưu đãi (checklist ALG 3.8)
  shipping_fee       Decimal          @default(0) @db.Decimal(12, 2)
  total_amount       Decimal          @default(0) @db.Decimal(12, 2)
  terms              String? // Điều kiện & điều khoản báo giá
  notes              String? // Ghi chú nội bộ
  converted_order_id String?
  created_by         String
  created_at         DateTime         @default(now()) @db.Timestamptz(3)
  updated_at         DateTime         @updatedAt @db.Timestamptz(3)

  organization    organizations         @relation(fields: [organization_id], references: [id])
  lead            leads?                @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  customer        customers?            @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  asset_usage     asset_usages?         @relation(fields: [asset_usage_id], references: [id], onDelete: SetNull)
  converted_order orders?               @relation("quotation_converted_order", fields: [converted_order_id], references: [id], onDelete: SetNull)
  items           quotation_items[]
  revisions       quotation_revisions[]

  @@unique([organization_id, code])
  @@unique([id, organization_id]) // đích của khoá ghép tenant (05/11/2026)
  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, created_at])
  @@index([lead_id])
  @@index([customer_id])
  @@index([asset_usage_id]) // khoá ngoại cần index (ADR-015 O-1)
  @@index([converted_order_id]) // khoá ngoại cần index (ADR-015 O-1)
}

/// Chi tiết từng dòng sản phẩm trong báo giá (Quotation Items).
model quotation_items {
  id              String   @id @default(uuid())
  organization_id String
  quotation_id    String
  product_id      String?
  name            String
  /// Phiên bản kích cỡ khách chọn cho dòng này, ví dụ "Lớn" (checklist ALG 3.8)
  variant_label   String?
  qty             Int      @default(1)
  unit_price      Decimal  @default(0) @db.Decimal(12, 2)
  total_price     Decimal  @default(0) @db.Decimal(12, 2)
  note            String?
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  quotation    quotations    @relation(fields: [quotation_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  product      products?     @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([quotation_id])
  @@index([product_id])
}

/// Ảnh chụp báo giá trước mỗi lần sửa (checklist ALG 3.10): dòng, tổng, người sửa, thời điểm. TENANT ISOLATION.
model quotation_revisions {
  id              String   @id @default(uuid())
  organization_id String
  quotation_id    String
  version         Int
  snapshot        Json
  created_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  quotation    quotations    @relation(fields: [quotation_id, organization_id], references: [id, organization_id], onDelete: Cascade)

  @@unique([quotation_id, version])
  @@index([organization_id])
  @@index([organization_id, quotation_id])
}

enum customer_segment_kind {
  DYNAMIC
  STATIC
}

enum customer_interaction_channel {
  ZALO
  PHONE
  SMS
  EMAIL
  IN_PERSON
  OTHER
}

enum customer_interaction_direction {
  OUTBOUND
  INBOUND
}

/// Phân khúc khách hàng (Customer Segments) — Chăm sóc khách hàng (PO 01/11/2026, PR-5).
/// Hỗ trợ lọc động theo RFM, hạng khách, dịp đặc biệt, lần mua cuối, và đồng ý nhận tin.
model customer_segments {
  id              String                @id @default(uuid())
  organization_id String
  name            String
  description     String?
  kind            customer_segment_kind @default(DYNAMIC)
  rules           Json? // Zod schema: tier, rfmMin, rfmMax, occasions, lastPurchaseDays, tags, consentChannel
  created_by      String
  created_at      DateTime              @default(now()) @db.Timestamptz(3)
  updated_at      DateTime              @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
  @@index([organization_id, kind])
  @@index([organization_id, created_at])
}

/// Nhật ký tương tác & chăm sóc khách hàng (Customer Interactions) — Chăm sóc khách hàng (PO 01/11/2026, PR-5).
model customer_interactions {
  id              String                         @id @default(uuid())
  organization_id String
  customer_id     String
  channel         customer_interaction_channel
  direction       customer_interaction_direction @default(OUTBOUND)
  asset_usage_id  String?
  summary         String
  outcome         String?
  occurred_at     DateTime                       @default(now()) @db.Timestamptz(3)
  created_by      String
  created_at      DateTime                       @default(now()) @db.Timestamptz(3)
  updated_at      DateTime                       @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  customer     customers     @relation(fields: [customer_id, organization_id], references: [id, organization_id], onDelete: Cascade)
  asset_usage  asset_usages? @relation(fields: [asset_usage_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([organization_id, customer_id, occurred_at])
  @@index([customer_id])
  @@index([asset_usage_id])
}

enum print_rendition_status {
  PENDING
  READY
  FAILED
}

/// Bản in chuẩn quy cách kỹ thuật (Print Renditions) — Ấn phẩm & In ấn (PO 01/11/2026, PR-6).
model print_renditions {
  id              String                 @id @default(uuid())
  organization_id String
  asset_id        String?
  asset_usage_id  String?
  source_type     String
  source_id       String?
  preset_code     String
  width_mm        Decimal                @db.Decimal(8, 2)
  height_mm       Decimal                @db.Decimal(8, 2)
  bleed_mm        Decimal                @default(3) @db.Decimal(5, 2)
  dpi             Int                    @default(300)
  storage_key     String?
  file_url        String?
  preflight       Json?
  status          print_rendition_status @default(PENDING)
  created_by      String
  created_at      DateTime               @default(now()) @db.Timestamptz(3)
  updated_at      DateTime               @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id])
  asset_usage  asset_usages? @relation(fields: [asset_usage_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, preset_code])
  @@index([organization_id, created_at])
  @@index([asset_usage_id])
}

// ── Đối soát số dư (ADR-013 D-I6, bước I-3) ────────────────────────────────
// Một dòng cho mỗi đơn (hay đối tượng) đang lệch. Job đối soát mở dòng khi phát hiện lệch, đóng
// (`resolved_at`) khi số liệu khớp lại, mở lại cùng dòng nếu lệch lần nữa. Không tự sửa số liệu.

// ORDER_PAID_MISMATCH: orders.paid_vnd khác tổng sổ thu đã xác nhận (khoản hoàn tiền trừ ra).
enum reconciliation_kind {
  ORDER_PAID_MISMATCH
}

model reconciliation_findings {
  id                String              @id @default(uuid())
  organization_id   String
  kind              reconciliation_kind
  entity_id         String
  expected_vnd      Decimal             @db.Decimal(14, 2)
  actual_vnd        Decimal             @db.Decimal(14, 2)
  first_detected_at DateTime            @default(now()) @db.Timestamptz(3)
  last_detected_at  DateTime            @default(now()) @db.Timestamptz(3)
  resolved_at       DateTime?           @db.Timestamptz(3)
  created_at        DateTime            @default(now()) @db.Timestamptz(3)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([kind, entity_id])
  @@index([organization_id])
  @@index([organization_id, resolved_at])
}

// ── Cây tổ chức (ADR-012 D-T3, bước T-2) ────────────────────────────────────
// Quan hệ giữa các tổ chức là đồ thị có hướng cha → con. "Tầng trên" của một tổ chức đi theo cạnh
// is_primary (một cạnh chính ACTIVE mỗi tổ chức con — trigger trong migration giữ luật này).
// Thay `chain_partnerships` (xoá ở T-3b, migration 20261106020000): id các liên kết cũ giữ nguyên.

enum organization_link_type {
  SUBCONTRACTOR
  FRANCHISE
  INDUSTRY_MEMBER
  AFFILIATE
}

enum organization_link_status {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

model organization_links {
  id              String                   @id @default(uuid())
  parent_org_id   String
  child_org_id    String
  link_type       organization_link_type   @default(SUBCONTRACTOR)
  status          organization_link_status @default(ACTIVE)
  is_primary      Boolean                  @default(false)
  valid_from      DateTime                 @default(now()) @db.Timestamptz(3)
  valid_to        DateTime?                @db.Timestamptz(3)
  partner_code    String
  capacity_daily  Int                      @default(10)
  commission_rate Decimal?
  /// @pii identity
  contact_name    String?
  /// @pii contact
  contact_phone   String?
  /// @pii contact
  contact_email   String?
  /// @pii business
  address         String?
  province        String?
  district        String?
  created_at      DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at      DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)

  parent_organization organizations @relation("OrgLinkParent", fields: [parent_org_id], references: [id], onDelete: Cascade)
  child_organization  organizations @relation("OrgLinkChild", fields: [child_org_id], references: [id], onDelete: Cascade)

  @@unique([parent_org_id, child_org_id])
  @@unique([parent_org_id, partner_code])
  @@index([parent_org_id, status])
  @@index([child_org_id, status])
}

/// Checklist ALG 10.8 (PO 06/11/2026): tên miền riêng của cửa hàng cho trang danh mục và Thẻ Chào.
/// Chỉ phục vụ khi VERIFIED (bản ghi TXT đúng mã xác minh); LOCKED do Console nền tảng khoá, cửa hàng không tự gỡ.
enum custom_domain_status {
  PENDING
  VERIFIED
  LOCKED
}

/// Chứng chỉ HTTPS (PO Q11): cấp tự động qua API Render; chưa cấu hình khoá API → MANUAL (vận hành thêm tay).
enum custom_domain_certificate_status {
  NOT_REQUESTED
  REQUESTED
  MANUAL
  FAILED
}

model custom_domains {
  id                 String                           @id @default(uuid())
  organization_id    String
  hostname           String                           @unique
  verification_token String
  status             custom_domain_status             @default(PENDING)
  verified_at        DateTime?                        @db.Timestamptz(3)
  last_checked_at    DateTime?                        @db.Timestamptz(3)
  certificate_status custom_domain_certificate_status @default(NOT_REQUESTED)
  locked_reason      String?
  created_by         String?
  created_at         DateTime                         @default(now()) @db.Timestamptz(3)
  updated_at         DateTime                         @default(now()) @updatedAt @db.Timestamptz(3)

  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
}
