# ══════════════════════════════════════════════════════════════════════════════
# smeOS — mẫu biến môi trường của bản giao Giai đoạn 1
#
# Cách dùng:  cp .env.example .env   rồi điền giá trị thật.
#   [BẮT BUỘC]  thiếu là app không khởi động (src/lib/env.ts kiểm lúc chạy).
#   [PROD]      không bắt buộc ở máy dev nhưng phải có trên production.
#   (tuỳ chọn)  để trống → tính năng đó tắt hoặc lùi về đường cục bộ, không lỗi.
#
# Không bao giờ commit file .env. Sinh bí mật ngẫu nhiên:  openssl rand -hex 32
# Biến NEXT_PUBLIC_* được gắn vào bản build — đổi xong phải build/deploy lại.
# Mỗi biến chỉ khai MỘT lần (dotenv lấy dòng sau cùng nếu trùng).
# ══════════════════════════════════════════════════════════════════════════════


# ─── 1. CƠ SỞ DỮ LIỆU ────────────────────────────────────────────────────────
# [BẮT BUỘC] Postgres chính. Dev: `docker compose up -d` (cổng 5433).
DATABASE_URL="postgresql://smeos:smeos@localhost:5433/smeos"
# Row Level Security theo tổ chức (ADR-013): off | audit | enforce. Xem docs/handover/OPERATIONS_RUNBOOK.md §12.
DB_RLS_MODE=off
# Trần pool kết nối của web (mặc định 10) — ADR-015 D-O5
# DATABASE_POOL_MAX=10
# Database RIÊNG cho `npm run test:tenant` / `test:platform` (các bộ này TRUNCATE mọi bảng).
# Tên phải kết thúc bằng `_test`. Tạo một lần: `npm run db:test:setup`.
DATABASE_URL_TEST="postgresql://smeos:smeos@localhost:5433/smeos_test"


# ─── 2. BÍ MẬT CỦA ỨNG DỤNG (mỗi giá trị ≥ 16 ký tự, khác nhau) ─────────────
# [BẮT BUỘC] Ký phiên đăng nhập.
SESSION_SECRET=
# [BẮT BUỘC] Ký token máy-với-máy VÀ mã hoá khoá tích hợp lưu trong DB
# (token Facebook/Zalo, khoá Trung tâm Tích hợp). Đổi giá trị = mọi khoá đã lưu không giải mã được nữa.
INTEGRATION_TOKEN_SECRET=
# [BẮT BUỘC ở production, ADR-014 P-5c] khoá chủ mã hoá dữ liệu cá nhân, 32 byte base64 (openssl rand -base64 32). Trống ở máy dev = khoá thử.
PII_ENCRYPTION_KEY=
# [BẮT BUỘC] Ký JWT phiên liên kết (SSO).
SSO_SESSION_SECRET=
# (tuỳ chọn) Ký URL kho tệp. Trống → dùng SESSION_SECRET.
STORAGE_SIGNING_SECRET=
# [PROD] Secret cho cron nội bộ (header `x-cron-secret`): /internal/chain-dispatch-sweep,
# /internal/integrations-sweep, /internal/health. Production thiếu → endpoint luôn từ chối; dev trống = "dev".
CRON_SECRET=


# ─── 3. ĐỊA CHỈ CÔNG KHAI & MÔI TRƯỜNG ──────────────────────────────────────
# URL công khai của app — dựng link gửi khách/chi nhánh, mã nhúng chat, ảnh gửi kênh bán.
# Trên Render để trống PUBLIC_APP_URL: tự dùng RENDER_EXTERNAL_URL (Render tự đặt).
PUBLIC_APP_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3200
# Tên miền riêng của cửa hàng (checklist ALG 10.8): khoá API Render + mã dịch vụ web để tự gắn tên miền và cấp
# chứng chỉ HTTPS. Trống → cửa hàng vẫn xác minh được, vận hành thêm tay. Xem docs/handover/OPERATIONS_RUNBOOK.md §13.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# Máy chủ cửa hàng trỏ CNAME về (mặc định lấy từ RENDER_EXTERNAL_URL)
# CUSTOM_DOMAIN_TARGET=
# (tuỳ chọn) URL gốc dùng trong link Telegram và tệp xuất dữ liệu; trống → NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL=
# KHÔNG đặt `production` cho bản giao: biến này bật khoá "Sắp ra mắt" (src/lib/feature-lock.ts) vốn dành cho
# bản đầy đủ và sẽ khoá nhầm chức năng đã giao. Để trống.
NEXT_PUBLIC_APP_ENV=
# (tuỳ chọn) Chỉ dùng dựng link khi dev mà chưa khai URL công khai (mặc định 3100). Lưu ý `npm run dev` chạy cổng 3200.
PORT=
# (tuỳ chọn) Mức log của worker Python: DEBUG | INFO | WARNING | ERROR. Mặc định INFO.
LOG_LEVEL=
# (tuỳ chọn) Tạo hồ sơ/dữ liệu mẫu cho tổ chức mới ngoài dev (máy demo/staging): true.
SEED_DEV_DATA=
# Số proxy tin cậy đứng trước app (Render = 1; thêm CDN như Cloudflare = 2). Trống = 1.
RATE_LIMIT_TRUSTED_PROXY_HOPS=


# ─── 4. HẠ TẦNG: KHO TỆP, REDIS, THEO DÕI LỖI ───────────────────────────────
# Kho tệp tương thích S3 (Amazon S3, Cloudflare R2, MinIO). Đủ 4 ô thì web + worker dùng kho này;
# thiếu một ô → cả hai dùng `var/storage` trên đĩa (chỉ ổn khi cùng máy; mất ảnh khi deploy lại).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# `auto` cho Cloudflare R2; tên vùng thật cho Amazon S3 (vd. ap-southeast-1).
STORAGE_REGION=auto
# Production thiếu một trong 4 biến STORAGE_* thì mọi thao tác tệp báo lỗi và /api/health/ready trả 503
# (không còn lặng lẽ lưu xuống đĩa cục bộ). Chỉ đặt "true" ở CI / máy thử chạy bản build production.
# ALLOW_LOCAL_STORAGE=
# Chỉ đặt "true" trên Render: bỏ kiểm kiểu trong `next build` vì commit đã qua typecheck ở CI (P0-08).
# SKIP_BUILD_TYPECHECK=
# Xoá tệp trên kho khi xoá vĩnh viễn: enabled | disabled (mặc định tắt tới khi kho có bản sao lưu).
STORAGE_DELETE_PAYLOADS=

# Redis cho giới hạn tần suất dùng chung nhiều instance. Trống → đếm trong bộ nhớ tiến trình.
REDIS_URL=

# Sentry (web + worker). Trống → tắt, chỉ log JSON. Không gửi body/cookie/header/người dùng.
SENTRY_DSN=
# Tên môi trường trên Sentry (production, staging…). Trống = NODE_ENV (web) / production (worker).
SENTRY_ENVIRONMENT=

# Giới hạn số job AI mỗi tổ chức trong một cửa sổ thời gian. Trống → mặc định trong mã
# (src/modules/jobs/domain/rate-limit.ts).
JOB_RATE_LIMIT_PER_WINDOW=
JOB_RATE_LIMIT_WINDOW_SECONDS=


# ─── 5. EMAIL & THÔNG BÁO ───────────────────────────────────────────────────
# Email thông báo (SMTP). Trống SMTP_HOST → kênh email tắt.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Địa chỉ gửi; trống → SMTP_USER.
SMTP_FROM=

# Telegram — bot của hệ thông báo 4 tầng (đơn mới, việc cần làm…). Trống → kênh Telegram tắt.
TELEGRAM_BOT_TOKEN=
# Telegram — bot điều phối đơn gia công chuỗi → chi nhánh. Trống → dùng TELEGRAM_STAFF_BOT_TOKEN.
TELEGRAM_DISPATCH_BOT_TOKEN=
TELEGRAM_STAFF_BOT_TOKEN=


# ─── 6. KÊNH NHẮN TIN: ZALO ─────────────────────────────────────────────
# Zalo OA CHUNG của nền tảng — mời/nhắc việc nhân viên chi nhánh đã quan tâm OA. Trống → kênh Zalo tắt.
# REFRESH_TOKEN chỉ dùng lần đầu; sau đó hệ thống tự làm mới và niêm phong trong bảng platform_secrets.
# WEBHOOK_SECRET = "OA Secret Key"; trỏ webhook OA về /api/v1/public/zalo-oa/webhook.
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_WEBHOOK_SECRET=
# Link quan tâm OA hiển thị cho cửa hàng (vd. https://zalo.me/<oa-id>).
ZALO_OA_FOLLOW_URL=


# ─── 7. NHÀ CUNG CẤP AI (khoá nền tảng, không phải khoá của tổ chức) ─────────
# Không bao giờ đi qua trình duyệt, không nằm trong bảng nào. Mọi lời gọi đi qua cổng AI
# (src/core/ai/gateway.ts); thứ tự nhà cung cấp chỉnh ở /cai-dat-ai. Bên nào thiếu khoá bị bỏ qua,
# mọi bên lỗi → lùi về bộ máy cục bộ.

# OpenAI — ảnh gpt-image-1, nội dung GPT. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic Claude — kịch bản, bài đăng. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Gemini/Imagen — ảnh thương mại, phân tích đa phương thức.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Photoroom — tách nền sản phẩm, bóng đổ, ánh sáng studio. https://photoroom.com/api
PHOTOROOM_API_KEY=
PHOTOROOM_TIMEOUT_SECONDS=90
# fal.ai — tách nền BiRefNet, BRIA Product Shot/Expand. https://fal.ai/dashboard/keys
FAL_KEY=
FAL_TIMEOUT_SECONDS=60
# Stability AI — biến thể ảnh marketing, Relight. https://platform.stability.ai/account/keys
STABILITY_API_KEY=
# Replicate — mở rộng khung ảnh (bria/expand-image). https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# ElevenLabs — lồng tiếng, nhân bản giọng (cần gói có Instant Voice Clone). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ─── 8. WORKER ẢNH (Python — workers/) ──────────────────────────────
# Nhà cung cấp tăng chất lượng ảnh mặc định khi job không chỉ định (mặc định `studio` — cục bộ).
DEFAULT_ENHANCER_PROVIDER=
# Thứ tự nhà cung cấp trọn gói cho ảnh biến thể Khu vực D (bên thiếu khoá bị bỏ qua).
VARIANT_PROVIDER_ORDER=fal,stability
# Model tách chủ thể (rembg). Trống → `isnet-general-use` (Apache-2.0).
# KHÔNG dùng `bria-rmbg` cho khách thật (giấy phép phi thương mại). `u2netp` chỉ để lặp nhanh khi dev.
VARIANT_SEGMENTATION_MODEL=
VARIANT_SEGMENTATION_TIMEOUT_SECONDS=90
# Ngưỡng toàn vẹn chủ thể (mặc định 0.99; dev với u2netp có thể hạ 0.95). Dưới ngưỡng → job REJECTED.
VARIANT_INTEGRITY_THRESHOLD=
# Đường dẫn model Real-ESRGAN (phóng to ảnh). Trống → đường mặc định trong mã; worker hiện chưa cài.
REALESRGAN_MODEL_PATH=
# IOPaint tự host (đã dừng làm đường chính — nợ #104). Trống IOPAINT_URL → lùi bộ máy cục bộ.
IOPAINT_URL=
IOPAINT_MODEL=kandinsky-community/kandinsky-2-2-decoder-inpaint
IOPAINT_TIMEOUT_SECONDS=120


# ─── 9. DỊCH VỤ KHÁC ───────────────────────────────────────────────────────
# Goong — đổi địa chỉ thành toạ độ để phân đơn gia công theo khoảng cách. Trống → không tính khoảng cách.
GOONG_API_KEY=
# Cloudflare Turnstile — xác minh người thật cho form công khai. Khai CẢ HAI để bật.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# ─── 10. CỜ TÍNH NĂNG ───────────────────────────────────────────────────────
# Thẻ chào (Swipe Brochure). "false" hiện CHỈ tắt bộ quét nền, chưa ẩn menu/route/API (nợ #179).
GREETING_CARD_ENABLED=true
# Bộ quét nền Thẻ chào (gửi lại tin lỗi, nhắc/tự huỷ đơn quá hạn). "off" để tắt riêng.
GREETING_CARD_SWEEP=on
# Dòng thông báo xử lý dữ liệu cá nhân + trang /chinh-sach-bao-mat (D13). Bật: true, rồi build lại.
NEXT_PUBLIC_PRIVACY_NOTICE_ENABLED=


# ─── 11. CHỈ DÙNG KHI CHẠY SCRIPT / KIỂM THỬ (không cần cho app) ─────────────
# Mật khẩu mới khi chạy `npm run don-tai-khoan` (≥ 12 ký tự). Truyền qua dòng lệnh thì không cần khai.
# MAT_KHAU_MOI=
# Mật khẩu tài khoản thử của scripts/tao-tai-khoan-test.ts.
# MAT_KHAU_TEST01=
# MAT_KHAU_TEST02=
# Kiểm UX tự động (`npm run ux:audit`): địa chỉ app và thư mục báo cáo.
# UX_AUDIT_BASE_URL=http://localhost:3100
# UX_AUDIT_OUT=ux-audit-output
# Đường dẫn Chromium cho Playwright khi máy không dùng bản đi kèm.
# PW_CHROMIUM_PATH=
# In thêm log phân tích màu của worker vision.
# FLORAOS_DEBUG_MAU=1

# Biến do nền tảng tự đặt — KHÔNG khai tay:
#   NODE_ENV, NEXT_RUNTIME, RENDER_EXTERNAL_URL, RENDER_GIT_COMMIT, VERCEL_URL,
#   NEXT_PUBLIC_VERCEL_ENV, WEB_HOSTPORT (cron Render).

# ── Đăng bài tự động (Bước 4 nhóm "Tạo nội dung", PO 08/11/2026) ─────────────────────────────────────────
# Ứng dụng cấp nền tảng — cửa hàng chỉ bấm "Kết nối". Trống → kênh hiện "chưa mở".
# Cách đăng ký từng ứng dụng: docs/kien-truc/HUONG_DAN_DANG_KY_UNG_DUNG_MXH.md
# META_APP_ID=
# META_APP_SECRET=
# ZALO_SOCIAL_APP_ID=
# ZALO_SOCIAL_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
